---
import "../styles/global.css";
import Starfield from "../components/Starfield.astro";
import Header from "../components/Header.astro";
import ViewerFrame from "../components/ViewerFrame.astro";
import Hero from "../components/Hero.astro";
import Work from "../components/Work.astro";
import Projects from "../components/Projects.astro";
import Contact from "../components/Contact.astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Carlos J. Ortiz &mdash; Observatory</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		{/* stdDeviation="0 12": zero horizontal, 12 vertical — directional blur applied via filter: url(#warp-blur). */}
		<svg class="filter-defs" aria-hidden="true" width="0" height="0">
			<defs>
				<filter id="warp-blur">
					<feGaussianBlur stdDeviation="0 12" />
				</filter>
			</defs>
		</svg>
		<Starfield />
		<Header />
		<main class="section-stack">
			<Hero />
			<Work />
			<Projects />
			<Contact />
		</main>
		<ViewerFrame />
		<script>
			/*
			 * Sections use data-position="active|prev|next" to pick their slot.
			 * Siblings between outgoing and incoming snap silently via
			 * .no-transition so only the visible pair animates.
			 */
			const stack = document.querySelector<HTMLElement>('.section-stack');
			if (stack) {
				const sections = Array.from(
					stack.querySelectorAll<HTMLElement>(':scope > section')
				);
				const sectionIds = sections.map((s) => s.id);

				let currentIdx = 0;
				let animating = false;
				const TRANSITION_MS = 650;
				const COOLDOWN_MS = 800;
				const WHEEL_THRESHOLD = 30;
				const TOUCH_THRESHOLD = 50;

				sections.forEach((sec, i) => {
					sec.dataset.position = i === 0 ? 'active' : 'next';
				});

				function goTo(targetIdx: number) {
					if (animating) return;
					if (targetIdx < 0 || targetIdx >= sections.length) return;
					if (targetIdx === currentIdx) return;

					animating = true;
					const direction = targetIdx > currentIdx ? 'forward' : 'backward';
					const exitPos = direction === 'forward' ? 'prev' : 'next';
					const enterFromPos = direction === 'forward' ? 'next' : 'prev';

					document.body.classList.add('is-warping');
					document.body.classList.add(direction === 'forward' ? 'warp-fwd' : 'warp-bwd');

					const outgoing = sections[currentIdx];
					const incoming = sections[targetIdx];

					sections.forEach((sec, i) => {
						if (sec === outgoing || sec === incoming) return;
						sec.classList.add('no-transition');
						sec.dataset.position = i < targetIdx ? 'prev' : 'next';
					});

					if (incoming.dataset.position !== enterFromPos) {
						incoming.classList.add('no-transition');
						incoming.dataset.position = enterFromPos;
					}

					// Force reflow so the snapped positions take effect before
					// re-enabling transitions.
					void stack!.offsetHeight;

					sections.forEach((sec) => sec.classList.remove('no-transition'));

					// Force one more reflow before the actual animation, so
					// browsers register the transition from the new starting
					// position rather than collapsing the two style changes.
					void stack!.offsetHeight;

					outgoing.dataset.position = exitPos;
					incoming.dataset.position = 'active';

					setTimeout(() => {
						document.body.classList.remove('is-warping', 'warp-fwd', 'warp-bwd');
					}, TRANSITION_MS);

					setTimeout(() => {
						animating = false;
						currentIdx = targetIdx;
					}, COOLDOWN_MS);
				}

				// --- input: wheel ----------------------------------------
				window.addEventListener(
					'wheel',
					(e) => {
						if (animating) return;
						if (Math.abs(e.deltaY) < WHEEL_THRESHOLD) return;
						if (e.deltaY > 0) goTo(currentIdx + 1);
						else if (e.deltaY < 0) goTo(currentIdx - 1);
					},
					{ passive: true }
				);

				// --- input: keyboard -------------------------------------
				window.addEventListener('keydown', (e) => {
					if (animating) return;
					switch (e.key) {
						case 'ArrowDown':
						case 'PageDown':
							e.preventDefault();
							goTo(currentIdx + 1);
							break;
						case 'ArrowUp':
						case 'PageUp':
							e.preventDefault();
							goTo(currentIdx - 1);
							break;
						case 'Home':
							e.preventDefault();
							goTo(0);
							break;
						case 'End':
							e.preventDefault();
							goTo(sections.length - 1);
							break;
					}
				});

				// --- input: touch ----------------------------------------
				let touchStartY: number | null = null;
				window.addEventListener(
					'touchstart',
					(e) => {
						touchStartY = e.touches[0].clientY;
					},
					{ passive: true }
				);
				window.addEventListener(
					'touchend',
					(e) => {
						if (touchStartY === null || animating) return;
						const diff = touchStartY - e.changedTouches[0].clientY;
						touchStartY = null;
						if (Math.abs(diff) < TOUCH_THRESHOLD) return;
						if (diff > 0) goTo(currentIdx + 1);
						else goTo(currentIdx - 1);
					},
					{ passive: true }
				);

				// --- input: header anchor links --------------------------
				document
					.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')
					.forEach((a) => {
						a.addEventListener('click', (e) => {
							const href = a.getAttribute('href');
							if (!href) return;
							const idx = sectionIds.indexOf(href.slice(1));
							if (idx === -1) return;
							e.preventDefault();
							goTo(idx);
						});
					});

				// --- input: home logo ('/') ------------------------------
				document
					.querySelectorAll<HTMLAnchorElement>('a[href="/"]')
					.forEach((a) => {
						a.addEventListener('click', (e) => {
							e.preventDefault();
							goTo(0);
						});
					});
			}
		</script>
		<style is:global>
			body {
				font-family: 'Inter', system-ui, -apple-system, Segoe UI, sans-serif;
				font-weight: 400;
				line-height: 1.5;
				min-height: 100vh;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
			}
			* { box-sizing: border-box; }
		</style>
	</body>
</html>
