---
// Constellation of stack icons: hardware tribe (left, copper) and
// software tribe (right, cyan), bridged by a single Modbus<->GraphQL line.
// Data is intentionally hardcoded — this is a portfolio's "stack catalog",
// not a CMS-driven list.
---

<svg class="lines" viewBox="0 0 1000 625" preserveAspectRatio="none" aria-hidden="true">
  <polyline class="ln-hardware" points="80,180 165,95 220,260 130,360 250,440" />
  <line class="ln-hardware" x1="220" y1="260" x2="250" y2="440" />

  <polyline class="ln-software" points="780,140 870,230 830,380 720,440 920,520" />
  <line class="ln-software" x1="830" y1="380" x2="920" y2="520" />

  <line class="ln-bridge" x1="165" y1="95" x2="780" y2="140" />
  <line class="ln-bridge" x1="250" y1="440" x2="720" y2="440" />
</svg>

<div class="constellation">
  <a class="star tribe-hw mag-2 sz-md" style="top: 28.8%; left: 8%;" href="#" aria-label="PLC">
    <span class="glyph">PLC<span class="twinkle"></span></span>
    <span class="catalog">
      <span class="row1"><span class="name">PLC</span><span class="mag">m 2.1</span></span>
      <span class="cat-coord">14h 02m · +38°</span>
      <span class="cat">controllers</span>
    </span>
  </a>

  <a class="star tribe-hw mag-1 sz-xl" style="top: 15.2%; left: 16.5%;" href="#" aria-label="Modbus">
    <span class="glyph">Mb<span class="twinkle"></span></span>
    <span class="catalog">
      <span class="row1"><span class="name">Modbus</span><span class="mag">m 0.4</span></span>
      <span class="cat-coord">14h 18m · +44°</span>
      <span class="cat">protocols</span>
    </span>
  </a>

  <a class="star tribe-hw mag-3 sz-sm" style="top: 41.6%; left: 22%;" href="#" aria-label="Microcontroller">
    <span class="glyph">μC</span>
    <span class="catalog">
      <span class="row1"><span class="name">Microcontroller</span><span class="mag">m 3.0</span></span>
      <span class="cat-coord">14h 41m · +24°</span>
      <span class="cat">embedded</span>
    </span>
  </a>

  <a class="star tribe-hw mag-2 sz-md hide-sm" style="top: 57.6%; left: 13%;" href="#" aria-label="IEC 60870">
    <span class="glyph">IEC<span class="twinkle"></span></span>
    <span class="catalog">
      <span class="row1"><span class="name">IEC 60870</span><span class="mag">m 1.8</span></span>
      <span class="cat-coord">15h 04m · +12°</span>
      <span class="cat">scada-protocol</span>
    </span>
  </a>

  <a class="star tribe-hw mag-3 sz-sm" style="top: 70.4%; left: 25%;" href="#" aria-label="SCADA">
    <span class="glyph">SC</span>
    <span class="catalog">
      <span class="row1"><span class="name">SCADA</span><span class="mag">m 2.6</span></span>
      <span class="cat-coord">15h 22m · −04°</span>
      <span class="cat">supervisory</span>
    </span>
  </a>

  <a class="star tribe-hw mag-4 sz-xs hide-sm" style="top: 86%; left: 9%;" href="#" aria-label="Sensors">
    <span class="glyph">∿</span>
    <span class="catalog">
      <span class="row1"><span class="name">Sensors</span><span class="mag">m 4.2</span></span>
      <span class="cat-coord">15h 48m · −18°</span>
      <span class="cat">analog-i/o</span>
    </span>
  </a>

  <a class="star tribe-sw mag-2 sz-md" style="top: 22.4%; left: 78%;" href="#" aria-label="Rust">
    <span class="glyph">Rs<span class="twinkle"></span></span>
    <span class="catalog">
      <span class="row1"><span class="name">Rust</span><span class="mag">m 1.5</span></span>
      <span class="cat-coord">17h 12m · +36°</span>
      <span class="cat">systems-lang</span>
    </span>
