  <line class="ln-hardware" x1="90" y1="537" x2="220" y2="475" />

  <polyline class="ln-software" points="880,200 960,312 880,500 780,400 880,200" />
  <line class="ln-software" x1="880" y1="200" x2="740" y2="112" />
  <line class="ln-software" x1="740" y1="112" x2="500" y2="75" />
</svg>

<div class="constellation">
