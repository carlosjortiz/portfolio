  <a class="star tribe-sw mag-2 sz-md hide-sm" style="top: 70.4%; left: 72%;" href="#" aria-label="OAuth 2">
    <span class="glyph">OA<span class="twinkle"></span></span>
    <span class="catalog">
      <span class="row1"><span class="name">OAuth 2</span><span class="mag">m 1.9</span></span>
