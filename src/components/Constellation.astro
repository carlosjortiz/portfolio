<style>
  .constellation {
    position: absolute;
    inset: 0;
    z-index: 3;
  }
  /*
   * Promote the whole constellation above .hero-text (z-index: 4) only
   * while a star inside is being hovered or keyboard-focused. Without
   * this, the catalog popup of any star sitting under the headline /
   * lede would be visually masked by the text — even though the text
   * has pointer-events: none and lets the hover happen, the stacking
   * order keeps it painted on top. When nobody is interacting, the
   * constellation drops back to z=3 so the hero text reads cleanly
   * above the ambient star field.
   */
  .constellation:has(.star:hover),
  .constellation:has(.star:focus-visible) {
    z-index: 5;
  }

  /*
   * Mini-cluster wrapper carries the GROUP'S position. Width/height: 0 so it
   * doesn't affect layout — purely a positioning anchor. The first star
   * inside (with no inline style) is centered at the wrapper's anchor via
   * its own translate(-50%, -50%). Satellite stars override top/left with
   * pixel offsets so the cluster stays visually tight at any viewport size,
   * while moving the wrapper relocates the whole group.
   */
  .mini-cluster {
    position: absolute;
    width: 0;
    height: 0;
  }

  .star {
    position: absolute;
    transform: translate(-50%, -50%);
    cursor: pointer;
    --halo: color-mix(in oklch, var(--color-star-warm) 50%, transparent);
    --tone: var(--color-star-warm);
    text-decoration: none;
  }

  /* Stars inside a mini-cluster default to (0,0); their own
     translate(-50%, -50%) centers them on the wrapper's anchor point.
     Satellites override top/left via inline style with px offsets. */
  .mini-cluster > .star {
    top: 0;
    left: 0;
  }

  .star.mag-1 { animation: drift1 11s ease-in-out infinite; }
  .star.mag-2 { animation: drift2 13s ease-in-out infinite; }
  .star.mag-3 { animation: drift3 9s  ease-in-out infinite; }
  .star.mag-4 { animation: drift4 14s ease-in-out infinite; }

  @keyframes drift1 {
    0%, 100% { transform: translate(-50%, -50%) translateY(0); }
    50%      { transform: translate(-50%, -50%) translateY(-6px); }
  }
  @keyframes drift2 {
    0%, 100% { transform: translate(-50%, -50%) translateY(0); }
    50%      { transform: translate(-50%, -50%) translateY(5px); }
  }
  @keyframes drift3 {
    0%, 100% { transform: translate(-50%, -50%) translateY(0); }
    50%      { transform: translate(-50%, -50%) translateY(-4px); }
  }
  @keyframes drift4 {
    0%, 100% { transform: translate(-50%, -50%) translateY(0); }
    50%      { transform: translate(-50%, -50%) translateY(3px); }
  }

  .star .glyph {
    position: relative;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
    transition:
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 0.3s,
      box-shadow 0.4s,
      background 0.3s;
  }

  /* Sizes inherit border-radius: 50% from the base rule above so every
     glyph is circular regardless of dimensions. */
  .star.sz-xl .glyph { width: 56px; height: 56px; font-size: 16px; }
  .star.sz-lg .glyph { width: 48px; height: 48px; font-size: 14px; }
  .star.sz-md .glyph { width: 40px; height: 40px; font-size: 12px; }
  .star.sz-sm .glyph { width: 32px; height: 32px; font-size: 11px; }
  .star.sz-xs .glyph { width: 26px; height: 26px; font-size: 10px; }

  .star .glyph.glyph-sensor {
    font-size: 16px;
  }
  .star .glyph.glyph-protocols {
    font-size: 16px;
  }
  .sensor-mark {
    display: block;
    line-height: 1;
    transform: translateY(-0.06em);
  }

  .star.mag-1 .glyph {
    opacity: 1.0;
    box-shadow:
      0 0 0 1px color-mix(in oklch, var(--color-text-primary) 2%, transparent),
      0 4px 24px -8px color-mix(in oklch, var(--color-background) 60%, transparent);
  }
  .star.mag-2 .glyph { opacity: 0.92; }
  .star.mag-3 .glyph { opacity: 0.78; }
  .star.mag-4 .glyph { opacity: 0.55; }

  .star.tribe-hw .glyph {
    color: var(--color-accent-primary);
    --halo: color-mix(in oklch, var(--color-accent-primary) 55%, transparent);
  }
  .star.tribe-sw .glyph {
    color: var(--color-accent-secondary);
    --halo: color-mix(in oklch, var(--color-accent-secondary) 50%, transparent);
  }
  .star.tribe-neu .glyph {
    color: var(--color-text-secondary);
    --halo: color-mix(in oklch, var(--color-star-warm) 40%, transparent);
  }

  .star .glyph::before {
    content: "";
    position: absolute;
    inset: -14px;
    border-radius: inherit;
    background: radial-gradient(circle at center, var(--halo), transparent 65%);
    opacity: 0;
    transition: opacity 0.4s;
    z-index: -1;
    filter: blur(6px);
  }

  .star:hover .glyph,
  .star:focus-visible .glyph {
    transform: scale(1.08);
    border-color: currentColor;
    background: var(--color-surface-2);
    opacity: 1;
  }
  .star:hover .glyph::before,
  .star:focus-visible .glyph::before {
    opacity: 1;
  }

  /*
   * Promote the hovered/focused star above its siblings so its catalog
   * popup is never occluded by adjacent stars (especially inside tight
   * mini-clusters where stars overlap spatially). Each .star is its own
   * stacking context via the translate(-50%, -50%) transform, so the
   * catalog's own z-index can't escape it — only lifting the whole .star
   * pulls the catalog above sibling stars rendered later in DOM order.
   */
  .star:hover,
  .star:focus-visible {
    z-index: 100;
  }

  .catalog {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 10px 14px;
    min-width: 168px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s, transform 0.25s;
    z-index: 10;
    backdrop-filter: blur(8px);
    box-shadow: 0 8px 28px -8px color-mix(in oklch, var(--color-background) 70%, transparent);
    display: block;
  }
  .catalog::before {
    content: "";
    position: absolute;
    top: -5px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 8px;
    height: 8px;
    background: var(--color-surface);
    border-left: 1px solid var(--color-border);
    border-top: 1px solid var(--color-border);
  }
  .star:hover .catalog,
  .star:focus-visible .catalog {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }
  .catalog .row1 {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
  }
  .catalog .name {
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 13px;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }
  .catalog .mag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    color: var(--color-text-muted);
    letter-spacing: 0.1em;
  }
  .catalog .cat-coord {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--color-text-secondary);
    letter-spacing: 0.04em;
    margin-bottom: 6px;
  }
  .catalog .cat {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 3px;
    border: 1px solid;
  }
  .star.tribe-hw .catalog .cat {
    color: var(--color-accent-primary);
    border-color: color-mix(in oklch, var(--color-accent-primary) 30%, transparent);
  }
  .star.tribe-sw .catalog .cat {
    color: var(--color-accent-secondary);
    border-color: color-mix(in oklch, var(--color-accent-secondary) 30%, transparent);
  }
  .star.tribe-neu .catalog .cat {
    color: var(--color-text-secondary);
    border-color: var(--color-border);
  }

  .star .twinkle {
    position: absolute;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: var(--color-star-warm);
    /* Percentage-based offsets so the dot lands ON the curved edge of
       the circular glyph at any size. The previous `4px` corner offset
       worked for rounded squares but fell outside the circle's curve. */
    top: 18%;
    right: 18%;
    box-shadow: 0 0 4px var(--color-star-warm);
    opacity: 0.6;
    animation: twinkle 4s ease-in-out infinite;
  }
  .star.tribe-sw .twinkle {
    background: var(--color-star-cool);
    box-shadow: 0 0 4px var(--color-star-cool);
  }
  .star.tribe-hw .twinkle {
    background: var(--color-star-amber);
    box-shadow: 0 0 4px var(--color-star-amber);
  }
  @keyframes twinkle {
    0%, 100% { opacity: 0.25; transform: scale(0.85); }
    50%      { opacity: 0.85; transform: scale(1.1); }
  }
  .star.mag-3 .twinkle, .star.mag-4 .twinkle { display: none; }

  @media (max-width: 760px) {
    .star.hide-sm { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .star,
    .star .twinkle {
      animation: none;
    }
    .star .glyph {
      transition: none;
    }
  }
</style>
