---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<div class="chart-frame" aria-hidden="true">
  <span class="chart-label">{label}</span>
  <span class="corner tl"></span>
  <span class="corner tr"></span>
  <span class="corner bl"></span>
  <span class="corner br"></span>
  <div class="ticks top">
    <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
  </div>
  <div class="ticks bottom">
    <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
  </div>
  <div class="ticks left">
    <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
  </div>
  <div class="ticks right">
    <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
  </div>
  <span class="coord ra-1">RA 14h</span>
  <span class="coord ra-2">RA 18h</span>
  <span class="coord dec-1">+42°</span>
  <span class="coord dec-2">−18°</span>
  <span class="chart-meta">EPOCH J2025.5 <span class="sep">·</span> MAG ≤ 4.2 <span class="sep">·</span> N=12</span>
</div>

<style>
  .chart-frame {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }
  .corner {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 1px solid var(--color-border);
    opacity: 0.7;
  }
  .corner.tl { top: 0; left: 0; border-right: none; border-bottom: none; }
  .corner.tr { top: 0; right: 0; border-left: none; border-bottom: none; }
  .corner.bl { bottom: 0; left: 0; border-right: none; border-top: none; }
  .corner.br { bottom: 0; right: 0; border-left: none; border-top: none; }

  .ticks {
    position: absolute;
    display: flex;
    pointer-events: none;
  }
  .ticks.top, .ticks.bottom {
    left: 22px;
    right: 22px;
    height: 6px;
    justify-content: space-between;
  }
  .ticks.top { top: 0; }
  .ticks.bottom { bottom: 0; }
  .ticks.left, .ticks.right {
    top: 22px;
    bottom: 22px;
    width: 6px;
    flex-direction: column;
    justify-content: space-between;
  }
  .ticks.left { left: 0; }
  .ticks.right { right: 0; }
  .ticks span {
    background: var(--color-border);
    opacity: 0.6;
  }
  .ticks.top span, .ticks.bottom span {
    width: 1px;
    height: 6px;
  }
  .ticks.left span, .ticks.right span {
    height: 1px;
    width: 6px;
  }

  .coord {
    position: absolute;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    opacity: 0.7;
  }
  .coord.ra-1  { top: -16px; left: 22%; }
  .coord.ra-2  { top: -16px; right: 22%; }
  .coord.dec-1 { left: -42px; top: 30%; }
  .coord.dec-2 { right: -42px; bottom: 30%; }

  .chart-label {
    position: absolute;
    top: -32px;
    left: 22px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .chart-label::before {
    content: "";
    width: 28px;
    height: 1px;
    background: var(--color-accent-secondary);
    opacity: 0.5;
  }
  .chart-meta {
    position: absolute;
    bottom: -28px;
    right: 22px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--color-text-muted);
    opacity: 0.85;
  }
  .chart-meta .sep {
    color: var(--color-border);
    margin: 0 10px;
  }

  @media (max-width: 760px) {
    .coord { display: none; }
    .chart-meta { font-size: 9px; }
  }
</style>
