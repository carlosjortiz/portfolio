---
/*
 * Canvas particle simulation. Each star carries color, size, magnitude,
 * twinkle phase and parallax depth.
 *
 * Warp (body.is-warping + body.warp-fwd|warp-bwd): stars accelerate
 * vertically opposite to the section transition, scaled by parallax
 * (depth cue). Canvas is faded via destination-out instead of cleared,
 * so previous positions linger as motion trails — fade alpha peaks at
 * warp, near-clear at idle.
 */
---

<div class="sky" aria-hidden="true"></div>
<canvas class="stars" aria-hidden="true"></canvas>

<style>
  .sky {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(ellipse 80% 60% at 70% 20%, color-mix(in oklch, var(--color-accent-secondary) 4%, transparent), transparent 60%),
      radial-gradient(ellipse 60% 50% at 20% 80%, color-mix(in oklch, var(--color-accent-primary) 3%, transparent), transparent 70%);
  }
  canvas.stars {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  type Tribe = 'warm' | 'cool' | 'amber' | 'dim';

  interface Star {
    x: number;
    y: number;
    size: number;
    tribe: Tribe;
    magnitude: number;
    twinklePhase: number;
    twinkleSpeed: number;
    driftY: number;
    parallax: number;
  }

  const COLORS: Record<Tribe, string> = {
    warm: '#F4E5C8',
    cool: '#DBE7F5',
    amber: '#E8B884',
    dim: '#334155',
  };

  const canvas = document.querySelector<HTMLCanvasElement>('canvas.stars');
  if (canvas) {
    const ctx = canvas.getContext('2d', { alpha: true })!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let w = 0;
    let h = 0;
    let stars: Star[] = [];
    let lastT = performance.now();

    // Velocity curve matches the derivative of the section's easeOutQuart
    // bezier (cubic-bezier(0.22, 1, 0.36, 1)) ≈ (1-t)^3, so stars decelerate
    // in lock-step with the section's perceived motion. Total duration runs
    // slightly past TRANSITION_MS so a residual lingers after settle.
    let warpProgress = 0;
    let warpDir: 1 | -1 = 1;
    let warpStartTime: number | null = null;
    const WARP_DURATION_MS = 950; // 650ms section + 300ms tail

    function resize() {
      const dpr = window.devicePixelRatio || 1;
      w = window.innerWidth;
      h = window.innerHeight;
      canvas!.width = Math.floor(w * dpr);
      canvas!.height = Math.floor(h * dpr);
      canvas!.style.width = w + 'px';
      canvas!.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      seed();
    }

    function seed() {
      // Density: ~1 star per 9000 px². Floor at 50 for small viewports.
      const count = Math.max(50, Math.floor((w * h) / 9000));
      stars = [];
      for (let i = 0; i < count; i++) {
        const r = Math.random();
        let tribe: Tribe;
        let size: number;
        let magnitude: number;
        if (r < 0.5) {
          tribe = 'dim';
          size = 0.5 + Math.random() * 0.6;
          magnitude = 0.35 + Math.random() * 0.15;
        } else if (r < 0.72) {
          tribe = 'warm';
          size = 1 + Math.random() * 0.9;
          magnitude = 0.55 + Math.random() * 0.25;
        } else if (r < 0.88) {
          tribe = 'cool';
          size = 0.9 + Math.random() * 1.1;
          magnitude = 0.55 + Math.random() * 0.25;
        } else {
          tribe = 'amber';
          size = 1.1 + Math.random() * 1.3;
          magnitude = 0.6 + Math.random() * 0.25;
        }
        stars.push({
          x: Math.random() * w,
          y: Math.random() * h,
          size,
          tribe,
          magnitude,
          twinklePhase: Math.random() * Math.PI * 2,
          twinkleSpeed: 0.3 + Math.random() * 1.2,
          driftY: (Math.random() - 0.5) * 1.5,
          // Bigger stars take more parallax during warp — depth cue.
          parallax: 0.5 + size * 0.7,
        });
      }
      ctx.clearRect(0, 0, w, h);
    }

    function readWarpTarget(): number {
      const isWarping = document.body.classList.contains('is-warping');
      if (document.body.classList.contains('warp-fwd')) warpDir = 1;
      else if (document.body.classList.contains('warp-bwd')) warpDir = -1;
      return isWarping ? 1 : 0;
    }

    function drawStaticFrame() {
      ctx.clearRect(0, 0, w, h);
      for (const s of stars) {
        ctx.fillStyle = COLORS[s.tribe];
        ctx.globalAlpha = s.magnitude * 0.85;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    }

    function tick(now: DOMHighResTimeStamp) {
      const dt = Math.min(50, now - lastT) / 1000;
      lastT = now;

      const target = readWarpTarget();
      // Run the curve for the FULL duration even after body.is-warping is
      // removed at TRANSITION_MS, so the tail plays out instead of snapping.
      const stillRunning =
        warpStartTime !== null && now - warpStartTime < WARP_DURATION_MS;
      if (target === 1 || stillRunning) {
        if (warpStartTime === null) warpStartTime = now;
        const elapsed = now - warpStartTime;
        const linear = Math.min(1, elapsed / WARP_DURATION_MS);
        warpProgress = Math.pow(1 - linear, 3);
      } else {
        warpProgress = 0;
        warpStartTime = null;
      }

      // destination-out erases previous pixels by their alpha. Higher source
      // alpha = more aggressive clear (short trails); low alpha = long trails.
      const eraseAlpha = 0.1 + (1 - warpProgress) * 0.85;
      ctx.globalCompositeOperation = 'destination-out';
      ctx.fillStyle = `rgba(0, 0, 0, ${eraseAlpha})`;
      ctx.fillRect(0, 0, w, h);
      ctx.globalCompositeOperation = 'source-over';

      // Vertical warp velocity in px/sec at peak. parallax scales by depth.
      const warpSpeedBase = 1400;

      for (const s of stars) {
        s.twinklePhase += s.twinkleSpeed * dt;
        const twinkle = 0.7 + 0.3 * Math.sin(s.twinklePhase);

        s.y += s.driftY * dt;
        s.y += -warpDir * warpSpeedBase * s.parallax * warpProgress * dt;

        if (s.y < -10) s.y = h + 10;
        if (s.y > h + 10) s.y = -10;

        ctx.fillStyle = COLORS[s.tribe];
        ctx.globalAlpha = twinkle * s.magnitude;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;

      requestAnimationFrame(tick);
    }

    window.addEventListener('resize', resize);
    resize();

    if (reduceMotion) {
      drawStaticFrame();
    } else {
      requestAnimationFrame(tick);
    }
  }
</script>
