---
import ChartFrame from "./ChartFrame.astro";

const showProjects = !import.meta.env.PROD;

type PlanetKind = "treew" | "gsi" | "ati";

type Project = {
  kind: PlanetKind;
  name: string;
  description: string;
  stack: string[];
  href: string;
  top: number;
  left: number;
  // Side the hover-callout extends toward (away from the planet),
  // so the diagonal leader points into open space.
  hoverSide: "left" | "right";
};

// Three planet slots — two real projects + one placeholder until Carlos decides.
// Planet visuals (treew = nebula, gsi = ringed giant, ati = pulsar) are
// duplicated from Work.astro because Astro scopes styles per component.
const projects: Project[] = [
  {
    kind: "treew",
    name: "Navis",
    description:
      "File-first API client. Like Postman or Insomnia, but works directly with .http files — no DB, no cloud.",
    stack: ["Rust", "Tauri 2", "React", "TypeScript", "Vite", "Tailwind", "tree-sitter"],
    href: "#",
    top: 55,
    left: 22,
    hoverSide: "right",
  },
  {
    kind: "gsi",
    name: "Marauder's Notes",
    description:
      "Cross-platform whiteboard note-taking app. Each note is a free-form board where you write, draw, paste, and embed anything.",
    stack: ["React", "Tauri", "Rust"],
    href: "#",
    top: 55,
    left: 50,
    hoverSide: "right",
  },
  {
    kind: "ati",
    name: "Project Lyra",
    description:
      "A new exploration in progress — details to be revealed.",
    stack: [],
    href: "#",
    top: 55,
    left: 78,
    hoverSide: "right",
  },
];
---

{showProjects && (
  <section id="projects" class="projects">
    <div class="projects-stage">
      <ChartFrame label="PROJECTS · WORK IN PROGRESS" />

      <div class="planets">
        {projects.map((p) => (
          <article
            class:list={["planet-slot", `slot-${p.kind}`]}
            style={`top: ${p.top}%; left: ${p.left}%;`}
          >
            <div class={`xstar ${p.kind}`}>
              <div class="body">
                {p.kind === "treew" && (
                  <>
                    <div class="neb-haze"></div>
                    <div class="neb-cloud"></div>
                    <div class="neb-core"></div>
                    <div class="neb-ring r1">
                      <span class="neb-pip p1"></span>
                      <span class="neb-pip p2"></span>
                    </div>
                    <div class="neb-ring r2"></div>
                  </>
                )}

                {p.kind === "gsi" && (
                  <>
                    <div class="giant-rings">
                      <div class="giant-ring outer"></div>
                      <div class="giant-ring mid"></div>
                      <div class="giant-ring inner"></div>
                      <span class="ring-orbiter"></span>
                    </div>
                    <div class="giant-atm"></div>
                    <div class="giant-body"></div>
                    <div class="giant-rings front">
                      <div class="giant-ring outer"></div>
                      <div class="giant-ring mid"></div>
                      <div class="giant-ring inner"></div>
                      <span class="ring-orbiter"></span>
                    </div>
                  </>
                )}

                {p.kind === "ati" && (
                  <>
                    <div class="pulsar-haze"></div>
                    <div class="pulsar-beam"></div>
                    <div class="pulsar-beam b2"></div>
                    <div class="pulsar-ring r1"></div>
                    <div class="pulsar-ring r2"></div>
                    <div class="pulsar-ring r3"></div>
                    <div class="pulsar-core"></div>
                  </>
                )}
              </div>

              {/* Default state: just the project name centered below the planet. */}
              <div class="hud">
                <h3 class="hud-name">{p.name}</h3>
              </div>

              {/* Hover state: diagonal leader + readout (name / repo / desc / stack).
                  Container is 380×220 — taller than Work's 380×150 callout so the
                  bottom row fits desc + wrapped stack chips. The diagonal anchors
                  at the container's bottom corner (planet center); the horizontal
                  line stays at y=95 so the top row keeps its 91px height. */}
              <div class:list={["hud-callout", `hover-${p.hoverSide}`]} aria-hidden="true">
                <svg class="hc-leader" viewBox="0 0 380 220" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                  {p.hoverSide === "left" ? (
                    <>
                      <path class="hc-leader-stroke" d="M 380 220 L 285 95 L 10 95" />
                      <circle class="hc-dot hc-dot-bend" cx="285" cy="95" r="2.5" />
                      <circle class="hc-dot hc-dot-end" cx="10" cy="95" r="2.5" />
                    </>
                  ) : (
                    <>
                      <path class="hc-leader-stroke" d="M 0 220 L 95 95 L 370 95" />
                      <circle class="hc-dot hc-dot-bend" cx="95" cy="95" r="2.5" />
                      <circle class="hc-dot hc-dot-end" cx="370" cy="95" r="2.5" />
                    </>
                  )}
                </svg>

                <div class="hc-row hc-row-top">
                  <span class="hc-name-out">{p.name}</span>
                  <a class="hc-repo-out" href={p.href}>repo <span class="arrow">&rarr;</span></a>
                </div>
                <div class="hc-row hc-row-bottom">
                  <p class="hc-desc-out">{p.description}</p>
                  {p.stack.length > 0 && (
                    <ul class="hc-chips">
                      {p.stack.map((s) => (<li class="hc-chip">{s}</li>))}
                    </ul>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .projects {
    position: relative;
    z-index: 2;
    min-height: calc(100vh - 76px);
    display: grid;
    place-items: center;
    padding: 40px 24px 80px;
  }
  .projects-stage {
    position: relative;
    width: 100%;
    max-width: 1240px;
    aspect-ratio: 16 / 10;
    max-height: 78vh;
  }

  /* ============================================================
     PROJECT PLANETS — three celestial bodies, one per project.
     Visuals duplicated from Work.astro because Astro scopes
     component styles. If a planet visual ever changes, update
     BOTH files (Work.astro and Projects.astro) in lockstep.
     ============================================================ */
  .planets {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
  }
  .planets > * { pointer-events: auto; }

  .planet-slot {
    position: absolute;
    transform: translate(-50%, -50%);
  }

  .xstar {
    position: relative;
    width: 140px;
    height: 140px;
    isolation: isolate;
  }

  .xstar .body {
    position: absolute;
    inset: 0;
  }

  /* ----------- TREEW · emission nebula ----------- */
  .xstar.treew .neb-core {
    position: absolute;
    inset: 32%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 50%,
        var(--color-star-warm) 0%,
        var(--color-accent-primary) 25%,
        rgba(251, 146, 60, 0.0) 60%);
    filter: blur(2px);
    z-index: 3;
    animation: neb-pulse 7s ease-in-out infinite;
  }
  .xstar.treew .neb-cloud {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      radial-gradient(circle at 38% 42%, rgba(251, 146, 60, 0.55) 0%, rgba(251, 146, 60, 0) 38%),
      radial-gradient(circle at 64% 58%, rgba(34, 211, 238, 0.42) 0%, rgba(34, 211, 238, 0) 42%),
      radial-gradient(circle at 50% 50%, rgba(244, 229, 200, 0.18) 0%, rgba(244, 229, 200, 0) 55%);
    filter: blur(8px);
    z-index: 2;
    transition: filter 320ms ease;
  }
  .xstar.treew .neb-haze {
    position: absolute;
    inset: -16%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 50%,
      rgba(34, 211, 238, 0.16), transparent 55%);
    filter: blur(20px);
    z-index: 1;
    opacity: 0.85;
    transition: opacity 320ms ease, transform 320ms ease;
  }
  .xstar.treew .neb-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px dashed;
    z-index: 4;
    opacity: 0.42;
    transition: opacity 280ms ease;
  }
  .xstar.treew .neb-ring.r1 {
    inset: -4%;
    border-color: var(--color-accent-primary);
    animation: spin-cw 60s linear infinite;
  }
  .xstar.treew .neb-ring.r2 {
    inset: -14%;
    border-color: var(--color-accent-secondary);
    border-style: dotted;
    opacity: 0.32;
    animation: spin-ccw 90s linear infinite;
  }
  .xstar.treew .neb-pip {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-star-warm);
    box-shadow: 0 0 6px var(--color-star-warm);
    z-index: 5;
  }
  .xstar.treew .neb-pip.p1 { top: -2px; left: 50%; transform: translateX(-50%); }
  .xstar.treew .neb-pip.p2 {
    bottom: -2px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-accent-secondary);
    box-shadow: 0 0 6px var(--color-accent-secondary);
  }

  .xstar.treew:hover .neb-core,
  .xstar.treew:focus-within .neb-core {
    filter: blur(1px) brightness(1.15);
  }
  .xstar.treew:hover .neb-haze,
  .xstar.treew:focus-within .neb-haze {
    opacity: 1;
    transform: scale(1.08);
  }
  .xstar.treew:hover .neb-cloud,
  .xstar.treew:focus-within .neb-cloud {
    filter: blur(6px) brightness(1.1);
  }
  .xstar.treew:hover .neb-ring,
  .xstar.treew:focus-within .neb-ring { opacity: 0.75; }

  /* ----------- GSI · ringed gas giant ----------- */
  .xstar.gsi .giant-body {
    position: absolute;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background:
      radial-gradient(circle at 32% 32%,
        rgba(244, 229, 200, 0.85) 0%,
        rgba(232, 184, 132, 0.7) 18%,
        rgba(232, 184, 132, 0.0) 42%),
      linear-gradient(
        180deg,
        #2a2030 0%,
        #4a3848 18%,
        #6a4a52 32%,
        #8a5e58 44%,
        #6e4a52 56%,
        #4e3640 68%,
        #382838 82%,
        #1a1420 100%
      );
    box-shadow:
      inset -10px -14px 36px rgba(0,0,0,0.7),
      inset 6px 8px 18px rgba(244, 229, 200, 0.08),
      0 0 50px rgba(232, 184, 132, 0.12);
    z-index: 3;
    transition: box-shadow 320ms ease;
  }
  .xstar.gsi .giant-atm {
    position: absolute;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle at 50% 50%,
      rgba(232, 184, 132, 0) 60%,
      rgba(232, 184, 132, 0.18) 70%,
      rgba(232, 184, 132, 0) 78%);
    z-index: 2;
    transition: transform 320ms ease, opacity 320ms ease;
  }
  .xstar.gsi .giant-rings {
    position: absolute;
    width: 180px;
    height: 46px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-18deg);
    z-index: 1;
    transition: transform 480ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .xstar.gsi .giant-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }
  .xstar.gsi .giant-ring.outer {
    border: 1px solid rgba(232, 184, 132, 0.35);
    background: radial-gradient(ellipse at center,
      transparent 60%,
      rgba(232, 184, 132, 0.12) 70%,
      rgba(232, 184, 132, 0.22) 80%,
      transparent 92%);
  }
  .xstar.gsi .giant-ring.mid {
    inset: 5px 12px;
    border: 1px solid rgba(244, 229, 200, 0.25);
    background: radial-gradient(ellipse at center,
      transparent 55%,
      rgba(244, 229, 200, 0.08) 75%,
      transparent 90%);
  }
  .xstar.gsi .giant-ring.inner {
    inset: 11px 24px;
    border: 1px dashed rgba(34, 211, 238, 0.25);
  }
  .xstar.gsi .giant-rings.front {
    z-index: 4;
    clip-path: inset(50% 0 0 0);
  }

  .xstar.gsi .ring-orbiter {
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-star-warm);
    box-shadow:
      0 0 4px var(--color-star-warm),
      0 0 9px rgba(244, 229, 200, 0.55);
    pointer-events: none;
    offset-path: path('M 180 23 A 90 23 0 0 1 0 23 A 90 23 0 0 1 180 23');
    offset-distance: 0%;
    offset-rotate: 0deg;
    animation: ring-orbit 14s linear infinite;
    z-index: 6;
  }
  @keyframes ring-orbit {
    to { offset-distance: 100%; }
  }

  .xstar.gsi:hover .giant-body,
  .xstar.gsi:focus-within .giant-body {
    box-shadow:
      inset -10px -14px 36px rgba(0,0,0,0.7),
      inset 6px 8px 18px rgba(244, 229, 200, 0.14),
      0 0 80px rgba(232, 184, 132, 0.28);
  }
  .xstar.gsi:hover .giant-atm,
  .xstar.gsi:focus-within .giant-atm {
    transform: translate(-50%, -50%) scale(1.05);
  }
  .xstar.gsi:hover .giant-rings,
  .xstar.gsi:focus-within .giant-rings {
    transform: translate(-50%, -50%) rotate(-22deg);
  }

  /* ----------- ATI · pulsar ----------- */
  .xstar.ati .body {
    overflow: visible;
  }
  .xstar.ati .pulsar-core {
    position: absolute;
    width: 62px;
    height: 62px;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background:
      radial-gradient(circle at 50% 50%,
        var(--color-star-warm) 0%,
        var(--color-star-amber) 18%,
        var(--color-accent-primary) 42%,
        #8B3A0F 70%,
        #3D1A05 100%);
    box-shadow:
      0 0 24px rgba(232, 184, 132, 0.7),
      0 0 48px rgba(251, 146, 60, 0.45),
      0 0 96px rgba(251, 146, 60, 0.18),
      inset -4px -4px 12px rgba(0,0,0,0.4),
      inset 3px 3px 8px rgba(244, 229, 200, 0.5);
    z-index: 5;
    transition: box-shadow 320ms ease, transform 320ms ease;
  }
  .xstar.ati .pulsar-haze {
    position: absolute;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle at center,
      rgba(251, 146, 60, 0.22) 0%,
      rgba(251, 146, 60, 0.1) 25%,
      transparent 55%);
    filter: blur(6px);
    z-index: 1;
    opacity: 0.5;
    transition: opacity 320ms ease, transform 320ms ease;
  }
  .xstar.ati .pulsar-ring {
    position: absolute;
    border: 1px solid var(--color-accent-primary);
    border-radius: 50%;
    top: 50%;
    left: 50%;
    z-index: 2;
    opacity: 0;
    transition: opacity 320ms ease;
  }
  .xstar.ati .pulsar-ring.r1 {
    width: 80px;
    height: 80px;
    transform: translate(-50%, -50%);
    border-color: rgba(251, 146, 60, 0.55);
    animation: pulse-1 4.2s ease-out infinite;
    animation-play-state: running;
  }
  .xstar.ati .pulsar-ring.r2 {
    width: 90px;
    height: 90px;
    transform: translate(-50%, -50%);
    border-color: rgba(232, 184, 132, 0.4);
    border-style: dashed;
    animation: pulse-2 5.4s ease-out infinite;
    animation-play-state: running;
  }
  .xstar.ati .pulsar-ring.r3 {
    width: 100px;
    height: 100px;
    transform: translate(-50%, -50%);
    border-color: rgba(251, 146, 60, 0.25);
    animation: pulse-3 6.6s ease-out infinite;
    animation-play-state: running;
  }
  .xstar.ati .pulsar-beam {
    position: absolute;
    width: 200px;
    height: 1px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: linear-gradient(90deg,
      transparent 0%,
      rgba(244, 229, 200, 0.4) 45%,
      rgba(244, 229, 200, 0.7) 50%,
      rgba(244, 229, 200, 0.4) 55%,
      transparent 100%);
    z-index: 4;
    opacity: 0;
    filter: blur(0.5px);
    animation: spin-beam 18s linear infinite;
    transition: opacity 320ms ease;
  }
  .xstar.ati .pulsar-beam.b2 {
    animation-duration: 22s;
    animation-direction: reverse;
    transform: translate(-50%, -50%) rotate(60deg);
  }

  .xstar.ati:hover .pulsar-core,
  .xstar.ati:focus-within .pulsar-core {
    transform: translate(-50%, -50%) scale(1.08);
    box-shadow:
      0 0 36px rgba(232, 184, 132, 0.85),
      0 0 80px rgba(251, 146, 60, 0.6),
      0 0 140px rgba(251, 146, 60, 0.3),
      inset -4px -4px 12px rgba(0,0,0,0.4),
      inset 3px 3px 8px rgba(244, 229, 200, 0.6);
  }
  .xstar.ati:hover .pulsar-haze,
  .xstar.ati:focus-within .pulsar-haze {
    transform: translate(-50%, -50%) scale(1.1);
    opacity: 1;
  }
  .xstar.ati:hover .pulsar-ring,
  .xstar.ati:focus-within .pulsar-ring {
    opacity: 1;
  }
  .xstar.ati:hover .pulsar-beam,
  .xstar.ati:focus-within .pulsar-beam {
    opacity: 0.55;
  }
  .xstar.ati:hover .pulsar-beam.b2,
  .xstar.ati:focus-within .pulsar-beam.b2 {
    opacity: 0.3;
  }

  /* ============================================================
     DEFAULT HUD — just the project name, centered below the planet
     ============================================================ */
  .hud {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%);
    pointer-events: none;
    transition:
      opacity 220ms 120ms ease,
      transform 280ms 120ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .hud-name {
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.2;
    white-space: nowrap;
    text-align: center;
  }

  .xstar:hover .hud,
  .xstar:focus-within .hud {
    opacity: 0;
    transition: opacity 180ms ease, transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
    pointer-events: none;
    transform: translateX(-50%) translateY(-6px);
  }

  /* ============================================================
     HUD-CALLOUT — diagonal leader + readout (hover state)
     Container is 380×150; one bottom corner anchored at the
     planet center via hover-left / hover-right.
     ============================================================ */
  .hud-callout {
    position: absolute;
    bottom: 50%;
    width: 380px;
    /* 220px (vs Work's 150px) so the bottom row fits desc + wrapped chips and
       the .hud-callout bounding box always contains the full hover hit area —
       otherwise chips overflow past y=150 and the cursor falls into "dead
       space" outside .xstar/.hud-callout, dropping the :hover. */
    height: 220px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms ease;
    z-index: 6;
  }

  /*
   * Dead-zone fix: pointer-events does NOT inherit, so children of an
   * inert parent still catch mouse events on their own. The repo link,
   * chips, name, etc. each have their own default `auto`, which means
   * the cursor passing through their (invisible) bounding boxes was
   * triggering .xstar:hover from outside the planet.
   *
   * Force every descendant of the callout AND the default name HUD to
   * be inert by default. Only the planet body itself drives the hover
   * trigger — exactly what the user sees as "the planet area".
   */
  .hud *,
  .hud-callout * {
    pointer-events: none;
  }

  /*
   * On hover, the .hud-callout container receives auto (handled below)
   * so its bounding box keeps the hover alive. The repo link is the
   * only interactive descendant — re-enable just that one.
   */
  .xstar:hover .hc-repo-out,
  .xstar:focus-within .hc-repo-out {
    pointer-events: auto;
  }
  .hud-callout.hover-left {
    right: 50%;
    left: auto;
  }
  .hud-callout.hover-right {
    left: 50%;
    right: auto;
  }

  .xstar:hover .hud-callout,
  .xstar:focus-within .hud-callout {
    opacity: 1;
    pointer-events: auto;
    transition: opacity 220ms 80ms ease;
  }

  .hc-leader {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .hc-leader-stroke {
    fill: none;
    stroke: var(--color-accent-secondary);
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* Path length: ~157 (diagonal sqrt(95²+125²)) + 275 (horizontal) ≈ 432.
       Round up to 440 to cover floating-point variance. */
    stroke-dasharray: 440;
    stroke-dashoffset: 440;
    transition: stroke-dashoffset 720ms cubic-bezier(0.4, 0, 0.2, 1) 80ms;
    filter: drop-shadow(0 0 3px color-mix(in oklch, var(--color-accent-secondary) 35%, transparent));
  }
  .xstar:hover .hc-leader-stroke,
  .xstar:focus-within .hc-leader-stroke {
    stroke-dashoffset: 0;
  }

  .hc-dot {
    fill: var(--color-accent-secondary);
    opacity: 0;
    transition: opacity 180ms ease;
    filter: drop-shadow(0 0 3px color-mix(in oklch, var(--color-accent-secondary) 60%, transparent));
  }
  .hc-dot-bend { transition: opacity 180ms 470ms ease; }
  .hc-dot-end  { transition: opacity 180ms 800ms ease; }
  .xstar:hover .hc-dot,
  .xstar:focus-within .hc-dot {
    opacity: 1;
  }

  /* Top row: above the horizontal line at y=95.
     DOM order is [name, repo]; flex space-between → name on visual left,
     repo on visual right, regardless of side. */
  .hc-row-top {
    position: absolute;
    top: 0;
    height: 91px;
    width: 275px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 4px;
    pointer-events: none;
  }
  .hover-left  .hc-row-top { left: 10px; }
  .hover-right .hc-row-top { left: 95px; }

  .hc-name-out {
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    line-height: 1.2;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 280ms 380ms ease, transform 320ms 380ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .hc-repo-out {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    /* pointer-events lives in the .xstar:hover override above — never on
       the base rule, otherwise it catches mouse events while the callout
       is invisible and ghost-triggers .xstar:hover. */
    display: inline-flex;
    align-items: center;
    gap: 6px;
    opacity: 0;
    transform: translateX(6px);
    transition:
      opacity 280ms 520ms ease,
      transform 320ms 520ms cubic-bezier(0.2, 0.8, 0.2, 1),
      color 0.25s;
  }
  .hc-repo-out:hover { color: var(--color-accent-primary); }
  .hc-repo-out .arrow {
    font-size: 10px;
    transition: transform 0.25s;
  }
  .hc-repo-out:hover .arrow { transform: translateX(2px); }

  /* Bottom row: below the horizontal line. Description + stack chips. */
  .hc-row-bottom {
    position: absolute;
    top: 101px;
    width: 275px;
    pointer-events: none;
  }
  .hover-left  .hc-row-bottom { left: 10px;  text-align: left;  }
  .hover-right .hc-row-bottom { left: 95px;  text-align: right; }

  .hc-desc-out {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0 0 8px;
    text-wrap: pretty;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 320ms 700ms ease, transform 360ms 700ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hc-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 320ms 820ms ease, transform 360ms 820ms cubic-bezier(0.2, 0.8, 0.2, 1);
    /* No pointer-events:auto here — chips are visual only. The blanket
       `.hud-callout *` rule keeps them inert so they never ghost-trigger
       .xstar:hover from outside the planet. */
  }
  .hover-left  .hc-chips { justify-content: flex-start; }
  .hover-right .hc-chips { justify-content: flex-end; }

  .hc-chip {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
    padding: 2px 7px;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    background: color-mix(in oklch, var(--color-surface-2) 50%, transparent);
  }

  .xstar:hover .hc-name-out,
  .xstar:focus-within .hc-name-out,
  .xstar:hover .hc-repo-out,
  .xstar:focus-within .hc-repo-out,
  .xstar:hover .hc-desc-out,
  .xstar:focus-within .hc-desc-out,
  .xstar:hover .hc-chips,
  .xstar:focus-within .hc-chips {
    opacity: 1;
    transform: translate(0, 0);
  }

  /* ============================================================
     SHARED KEYFRAMES
     ============================================================ */
  @keyframes spin-cw  { to { transform: rotate(360deg); } }
  @keyframes spin-ccw { to { transform: rotate(-360deg); } }
  @keyframes neb-pulse {
    0%, 100% { filter: blur(2px) brightness(1); }
    50%      { filter: blur(2px) brightness(1.15); }
  }
  @keyframes spin-beam {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to   { transform: translate(-50%, -50%) rotate(360deg); }
  }
  @keyframes pulse-1 {
    0%   { width: 80px;  height: 80px;  opacity: 0.75; }
    100% { width: 200px; height: 200px; opacity: 0;    }
  }
  @keyframes pulse-2 {
    0%   { width: 90px;  height: 90px;  opacity: 0.6;  }
    100% { width: 220px; height: 220px; opacity: 0;    }
  }
  @keyframes pulse-3 {
    0%   { width: 100px; height: 100px; opacity: 0.4;  }
    100% { width: 250px; height: 250px; opacity: 0;    }
  }

  /* ============================================================
     FOCUS-BLUR (in-section) — when one planet is hovered, blur
     and dim the other planet slots inside the projects-stage.
     ============================================================ */
  .planet-slot {
    transition: filter 360ms ease, opacity 360ms ease;
  }
  .projects-stage:has(.xstar:hover) .planet-slot:not(:has(.xstar:hover)),
  .projects-stage:has(.xstar:focus-within) .planet-slot:not(:has(.xstar:focus-within)) {
    filter: blur(5px);
    opacity: 0.4;
  }

  /* ============================================================
     RESPONSIVE — stack planets vertically on mobile, drop the
     hud-callout (no horizontal room), reveal the default hud
     plus extra info inline below the name.
     ============================================================ */
  @media (max-width: 760px) {
    .projects-stage {
      aspect-ratio: 4 / 5;
      max-height: none;
    }

    .planets {
      position: relative;
      display: grid;
      grid-template-columns: 1fr;
      gap: 64px;
      padding: 32px 16px;
      inset: auto;
    }
    .planet-slot {
      position: relative;
      top: auto !important;
      left: auto !important;
      transform: none;
      justify-self: center;
    }
    .xstar { width: 110px; height: 110px; }
    .xstar.gsi .giant-body { width: 76px; height: 76px; }
    .xstar.gsi .giant-rings { width: 144px; height: 38px; }
    .xstar.gsi .giant-atm { width: 88px; height: 88px; }
    .xstar.ati .pulsar-core { width: 50px; height: 50px; }
    .xstar.ati .pulsar-haze { width: 120px; height: 120px; }
    .xstar.ati .pulsar-beam { width: 160px; }

    /* No room for the diagonal callout — fall back to the default HUD. */
    .hud-callout { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .xstar.treew .neb-core,
    .xstar.treew .neb-ring,
    .xstar.treew .neb-ring.r1,
    .xstar.treew .neb-ring.r2,
    .xstar.ati .pulsar-ring,
    .xstar.ati .pulsar-beam,
    .xstar.gsi .ring-orbiter {
      animation: none !important;
    }
    .xstar .neb-cloud,
    .xstar .neb-haze,
    .xstar .giant-body,
    .xstar .giant-atm,
    .xstar .giant-rings,
    .xstar .pulsar-core,
    .xstar .pulsar-haze,
    .xstar .pulsar-ring,
    .xstar .pulsar-beam {
      transition: none !important;
    }
    .xstar.ati:hover .pulsar-ring,
    .xstar.ati:focus-within .pulsar-ring {
      opacity: 0.5;
    }
    .xstar.ati:hover .pulsar-beam,
    .xstar.ati:focus-within .pulsar-beam {
      opacity: 0.4;
    }

    .hud-callout,
    .hc-leader-stroke,
    .hc-dot,
    .hc-name-out,
    .hc-repo-out,
    .hc-desc-out,
    .hc-chips {
      transition: none !important;
    }
    .xstar:hover .hc-leader-stroke,
    .xstar:focus-within .hc-leader-stroke {
      stroke-dashoffset: 0;
    }

    .projects-stage:has(.xstar:hover) .planet-slot:not(:has(.xstar:hover)),
    .projects-stage:has(.xstar:focus-within) .planet-slot:not(:has(.xstar:focus-within)) {
      filter: none;
      opacity: 1;
    }
  }
</style>

