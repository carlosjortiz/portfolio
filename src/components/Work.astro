---
import ChartFrame from "./ChartFrame.astro";

type Experience = {
  role: string;
  company: string;
  dateStart: string;
  dateEnd: string;
  description: string;
};

// Top-down: most recent at the top, oldest at the bottom.
// The last entry has no trail beneath it (no meteor below to point to).
const experiences: Experience[] = [
  {
    role: "Senior Software Engineer",
    company: "Treew",
    dateStart: "Sept 2024",
    dateEnd: "Present",
    description:
      "Built 25+ backend microservices for e-commerce. Designed an AI Product Validator running 13 OpenAI agents in parallel with vector stores. Built a bulk SMS platform on Postgres LISTEN/NOTIFY with worker pools and SSE.",
  },
  {
    role: "Computer Science Specialist",
    company: "GSI",
    dateStart: "May 2023",
    dateEnd: "Mar 2026",
    description:
      "Backend and full-stack across e-commerce, fintech and healthcare insurance: .NET microservices, AWS Lambda, React/TS, Flutter mobile. Built an industrial SCADA in WPF/.NET with PLC and RFID traceability.",
  },
  {
    role: "Automation Specialist",
    company: "ATI",
    dateStart: "Oct 2019",
    dateEnd: "May 2023",
    description:
      "Configured and deployed PCVue-Seefox SCADA across 72 substations of the National Dispatch. Integrated K-Power Ship floating power plants. Modbus and IEC 60870-5 over the wire.",
  },
];
---

{/*
  Hidden 0×0 svg holding reusable defs (asteroid silhouette + meteor symbol +
  the gradients that paint body, leading-edge tint and crater pits). All
  meteors below are rendered via <use href="#meteor"/>, so this block must
  be in the DOM before the first reference.

  Inline hex literals are intentional: they are SVG `stop-color` values, and
  CSS custom properties (var(--color-*)) cannot be used as `stop-color` in
  Astro's static SSR output. Each stop is annotated with its design-system
  origin so updates stay in sync with global.css.
*/}
<svg width="0" height="0" style="position: absolute" aria-hidden="true">
  <defs>
    {/* BODY — terminator gradient (lit top-left → shadow bottom-right). */}
    <radialGradient id="meteor-body" cx="32%" cy="28%" r="78%">
      <stop offset="0%"   stop-color="#F4E5C8" stop-opacity="0.85"/>{/* --color-star-warm */}
      <stop offset="22%"  stop-color="#E8B884" stop-opacity="0.55"/>{/* --color-star-amber */}
      <stop offset="48%"  stop-color="#64748B" stop-opacity="1.00"/>{/* --color-text-muted */}
      <stop offset="78%"  stop-color="#1A2030" stop-opacity="1.00"/>{/* --color-surface-2 */}
      <stop offset="100%" stop-color="#0A0E1A" stop-opacity="1.00"/>{/* --color-background */}
    </radialGradient>

    {/* LEADING-EDGE warm tint — top arc only, hints at atmospheric heating. */}
    <radialGradient id="meteor-rim-glow" cx="40%" cy="0%" r="60%">
      <stop offset="0%"   stop-color="#E8B884" stop-opacity="0.32"/>{/* --color-star-amber */}
      <stop offset="40%"  stop-color="#FB923C" stop-opacity="0.12"/>{/* --color-accent-primary */}
      <stop offset="100%" stop-color="#FB923C" stop-opacity="0"/>
    </radialGradient>

    {/* CRATER FILL — dark pit pulled toward shadow side, lit-rim arc opposite. */}
    <radialGradient id="crater-fill" cx="62%" cy="62%" r="60%">
      <stop offset="0%"   stop-color="#0A0E1A" stop-opacity="0.78"/>
      <stop offset="55%"  stop-color="#1A2030" stop-opacity="0.55"/>
      <stop offset="78%"  stop-color="#64748B" stop-opacity="0.0"/>
      <stop offset="92%"  stop-color="#F4E5C8" stop-opacity="0.30"/>
      <stop offset="100%" stop-color="#F4E5C8" stop-opacity="0"/>
    </radialGradient>

    {/* Asteroid silhouette — 12-vertex irregular outline around a 28-radius circle. */}
    <clipPath id="asteroid-clip">
      <path d="M 32 4 L 42 6 L 51 12 L 56 22 L 60 33 L 56 44 L 49 53 L 38 58 L 26 60 L 14 54 L 6 44 L 3 31 L 6 18 L 14 10 Z"/>
    </clipPath>

    <symbol id="meteor" viewBox="0 0 64 64" overflow="visible">
      <g clip-path="url(#asteroid-clip)">
        <path
          d="M 32 4 L 42 6 L 51 12 L 56 22 L 60 33 L 56 44 L 49 53 L 38 58 L 26 60 L 14 54 L 6 44 L 3 31 L 6 18 L 14 10 Z"
          fill="url(#meteor-body)"
        />
        <rect x="-4" y="-4" width="72" height="32" fill="url(#meteor-rim-glow)"/>

        {/* 6 craters distributed asymmetrically. Sizes vary; same fill paints
            the 3D depression effect (pit + lit-rim arc). */}
        <ellipse cx="38" cy="20" rx="7"   ry="6.2" fill="url(#crater-fill)"/>
        <ellipse cx="18" cy="32" rx="5.5" ry="5"   fill="url(#crater-fill)"/>
        <ellipse cx="48" cy="36" rx="3.6" ry="3.4" fill="url(#crater-fill)"/>
        <ellipse cx="22" cy="14" rx="2.4" ry="2.2" fill="url(#crater-fill)"/>
        <ellipse cx="32" cy="46" rx="4.6" ry="4.2" fill="url(#crater-fill)"/>
        <ellipse cx="44" cy="50" rx="2.8" ry="2.6" fill="url(#crater-fill)"/>

        {/* Terminator deepener — extra shadow on the bottom-right hemisphere. */}
        <ellipse cx="46" cy="48" rx="34" ry="30" fill="#0A0E1A" opacity="0.32"/>
      </g>
      {/* Hairline outline so the silhouette stays defined against dark backgrounds. */}
      <path
        d="M 32 4 L 42 6 L 51 12 L 56 22 L 60 33 L 56 44 L 49 53 L 38 58 L 26 60 L 14 54 L 6 44 L 3 31 L 6 18 L 14 10 Z"
        fill="none" stroke="rgba(244,229,200,0.10)" stroke-width="0.6"
      />
    </symbol>
  </defs>
</svg>

<section id="work" class="work">
  <div class="work-stage">
    <ChartFrame label="WORK · HARDWARE × SOFTWARE" />

    <div class="timeline">
      {experiences.map((exp, idx) => {
        const hasTrail = idx < experiences.length - 1;
        const dropClass = idx === 0 ? "drop" : `drop delay-${idx}`;
        return (
          <article class="row">
            <div class="node-col">
              <div class="meteor-wrap">
                <svg class="meteor-svg" viewBox="0 0 64 64"><use href="#meteor"/></svg>
              </div>
              {hasTrail && (
                <div class="trail-wrap">
                  <div class="plume"></div>
                  <div class={dropClass}></div>
                </div>
              )}
            </div>
            <div class="content">
              <div class="row-header">
                <h3 class="row-company">{exp.company}</h3>
                <p class="row-date">{exp.dateStart} — {exp.dateEnd}</p>
              </div>
              <p class="row-role">{exp.role}</p>
              <p class="row-desc">{exp.description}</p>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .work {
    position: relative;
    z-index: 2;
    min-height: calc(100vh - 76px);
    display: grid;
    place-items: center;
    padding: 40px 24px 80px;
  }
  .work-stage {
    position: relative;
    width: 100%;
    max-width: 1240px;
    aspect-ratio: 16 / 10;
    max-height: 78vh;
    padding: 56px 64px 72px;
  }

  /* ============================================================
     TIMELINE LAYOUT
     ============================================================ */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
    /*
     * 808px = 96 (node-col) + 32 (gap) + 680 (matches .row-desc max-width).
     * Centered with margin auto so the whole meteor + text block sits in
     * the middle of the chart-frame instead of hugging the left edge.
     */
    max-width: 808px;
    margin: 0 auto;
  }
  .row {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 32px;
    align-items: flex-start;
    position: relative;
  }
  .row + .row { margin-top: 8px; }

  .node-col {
    width: 96px;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }
  .meteor-wrap {
    width: 64px;
    height: 64px;
    position: relative;
    flex-shrink: 0;
    z-index: 2;
  }
  .meteor-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 2px 6px rgba(10, 14, 26, 0.6));
  }

  /* ============================================================
     TRAIL — hairline beam with cyan→orange vertical gradient and
     a soft halo. The descending drop rides on top of it.
     ============================================================ */
  .trail-wrap {
    width: 4px;
    flex: 1;
    position: relative;
    margin-top: -4px;
    min-height: 130px;
    z-index: 1;
    overflow: visible;
  }

  .plume {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    width: 1px;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 1;
    /*
     * Vertical gradient narrating the career arc: cyan (--color-accent-secondary)
     * at the top fades through cool/warm into orange (--color-accent-primary)
     * and amber, dissolving to transparent right where the next meteor begins.
     */
    background: linear-gradient(
      180deg,
      rgba(34, 211, 238, 0.95) 0%,
      rgba(184, 212, 232, 0.85) 22%,
      rgba(244, 229, 200, 0.75) 48%,
      rgba(251, 146, 60, 0.65) 72%,
      rgba(232, 184, 132, 0.30) 92%,
      rgba(244, 229, 200, 0) 100%
    );
  }
  .plume::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    width: 5px;
    height: 100%;
    background: inherit;
    filter: blur(4px);
    opacity: 0.45;
  }

  /* Descending shockwave — the heartbeat travelling along the beam. */
  .drop {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translate(-50%, 0);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 50%,
      #FFFFFF 0%,
      var(--drop-color, #B8D4E8) 40%,
      rgba(184, 212, 232, 0) 100%
    );
    box-shadow:
      0 0 8px var(--drop-color, #B8D4E8),
      0 0 16px var(--drop-color, #B8D4E8);
    pointer-events: none;
    z-index: 3;
    animation:
      drop-fall 3s linear infinite,
      drop-tint 3s linear infinite;
  }
  /* Stagger the loops so the three trails breathe asynchronously. */
  .drop.delay-1 { animation-delay: -1s, -1s; }
  .drop.delay-2 { animation-delay: -2s, -2s; }

  /* Micro-comet tail trailing the drop, painted in the local trail color. */
  .drop::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 100%;
    transform: translateX(-50%);
    width: 2px;
    height: 16px;
    background: linear-gradient(
      to top,
      var(--drop-color, #B8D4E8) 0%,
      rgba(184, 212, 232, 0) 100%
    );
    filter: blur(0.5px);
    border-radius: 2px;
  }

  @keyframes drop-fall {
    0%   { top: 0%;   opacity: 0; }
    8%   { opacity: 1; }
    88%  { opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }
  /*
   * Tint cycle keeps the drop's color in step with the trail gradient as it
   * descends: cool at the top, warm near the bottom. Requires @property to
   * register --drop-color as an animatable <color> — without it the tint
   * snaps between keyframes instead of interpolating.
   */
  @keyframes drop-tint {
    0%   { --drop-color: #B8D4E8; } /* --color-star-cool */
    35%  { --drop-color: #22D3EE; } /* --color-accent-secondary */
    55%  { --drop-color: #F4E5C8; } /* --color-star-warm */
    80%  { --drop-color: #FB923C; } /* --color-accent-primary */
    100% { --drop-color: #F4E5C8; } /* --color-star-warm */
  }
  @property --drop-color {
    syntax: '<color>';
    initial-value: #B8D4E8;
    inherits: false;
  }

  /* ============================================================
     TEXT BLOCK
     ============================================================ */
  .content {
    padding-top: 4px;
    padding-bottom: 16px;
  }
  /*
   * Header row: company on the left (prominent cyan), date pushed to the
   * right at the same baseline. flex-wrap kicks in on narrow widths so the
   * date drops to its own line instead of squeezing the company name.
   */
  .row-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin: 0 0 4px;
  }
  .row-company {
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 22px;
    letter-spacing: -0.01em;
    color: var(--color-accent-secondary);
    margin: 0;
    line-height: 1.2;
  }
  .row-date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
    margin: 0;
    white-space: nowrap;
  }
  .row-role {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-primary);
    letter-spacing: 0.005em;
    margin: 0 0 14px;
  }
  .row-desc {
    font-family: 'Inter', sans-serif;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 680px;
    text-wrap: pretty;
  }

  @media (max-width: 760px) {
    .work-stage { padding: 40px 24px; }
    .row { grid-template-columns: 64px 1fr; gap: 20px; }
    .node-col { width: 64px; }
    .meteor-wrap { width: 48px; height: 48px; }
    .row-company { font-size: 17px; }
    .row-date { font-size: 12px; }
    .row-role { font-size: 13px; }
    .row-desc { font-size: 13.5px; }
  }

  @media (prefers-reduced-motion: reduce) {
    /*
     * Beam + halo + gradient stay; only the descending nucleus stops, so the
     * structure of the timeline never collapses into disconnected nodes.
     */
    .drop {
      animation: none !important;
      display: none !important;
    }
  }
</style>

<style is:global>
  /*
   * Shared transition setup for the page-wide focus-blur effects driven
   * by other sections (Projects today; Hero/Contact later if they add
   * their own hover triggers). The actual filter/opacity changes live
   * in each driving section's own <style is:global> block — this rule
   * just ensures those changes fade smoothly across the page chrome.
   */
  .sky,
  .stars,
  .hero-stage > *:not(.chart-frame),
  .work-stage > *:not(.chart-frame),
  .projects-stage > *:not(.chart-frame),
  .contact-stage > *:not(.chart-frame) {
    transition: filter 360ms ease, opacity 360ms ease;
  }
</style>
