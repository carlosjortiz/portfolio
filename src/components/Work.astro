---
import ChartFrame from "./ChartFrame.astro";

type PlanetKind = "treew" | "gsi" | "ati";

type Planet = {
  kind: PlanetKind;
  company: string;
  role: string;
  dateStart: string;
  dateEnd: string;
  description: string;
  top: string;
  left: string;
  // `side` controls where the default HUD sits relative to the planet.
  // `hoverSide` controls which way the callout (revealed on hover) extends.
  // They are intentionally decoupled so the default and hover layouts can
  // sit on opposite sides of the planet (e.g. GSI default on the right,
  // hover callout extending to the left).
  side: "left" | "right";
  hoverSide: "left" | "right";
};

// Bottom-up chronological order: oldest at the bottom, newest at the top.
// Order in the array reflects DOM order; visual ordering is set by top/left.
const planets: Planet[] = [
  {
    kind: "ati",
    company: "ATI",
    role: "Automation Specialist",
    dateStart: "Oct 2019",
    dateEnd: "May 2023",
    description:
      "Configured and deployed PCVue-Seefox SCADA across 72 substations of the National Dispatch. Integrated K-Power Ship floating power plants into the national energy system. Modbus and IEC 60870-5 over the wire.",
    top: "78%",
    left: "30%",
    side: "left",
    hoverSide: "right",
  },
  {
    kind: "gsi",
    company: "GSI",
    role: "Computer Science Specialist",
    dateStart: "May 2023",
    dateEnd: "Mar 2026",
    description:
      "Backend and full-stack across e-commerce, fintech, and healthcare insurance: .NET microservices, AWS Lambda, React/TS, Flutter mobile. Built an industrial SCADA system in WPF/.NET with PLC and RFID traceability.",
    top: "48%",
    left: "60%",
    side: "right",
    hoverSide: "left",
  },
  {
    kind: "treew",
    company: "Treew",
    role: "Senior Software Engineer",
    dateStart: "Sept 2024",
    dateEnd: "Present",
    description:
      "Built 25+ backend microservices for e-commerce. Designed an AI Product Validator running 13 OpenAI agents in parallel with vector stores. Built a bulk SMS platform on Postgres LISTEN/NOTIFY with worker pools and SSE.",
    top: "18%",
    left: "38%",
    side: "right",
    hoverSide: "right",
  },
];
---

<section id="work" class="work">
  <div class="work-stage">
    <ChartFrame label="WORK · HARDWARE × SOFTWARE" />

    <div class="constellation">
      <a class="star tribe-sw mag-1 sz-xl" style="top: 8%; left: 6%;" href="#" aria-label="C#">
        <span class="glyph">C#<span class="twinkle"></span></span>
        <span class="catalog">
          <span class="row1"><span class="name">C#</span><span class="mag">m 0.6</span></span>
          <span class="cat-coord">14h 22m · +57°</span>
          <span class="cat">language</span>
        </span>
      </a>

      <a class="star tribe-sw mag-3 sz-sm" style="top: 4%; left: 88%;" href="#" aria-label="JavaScript">
        <span class="glyph">Js</span>
        <span class="catalog">
          <span class="row1"><span class="name">JavaScript</span><span class="mag">m 2.5</span></span>
          <span class="cat-coord">18h 04m · +49°</span>
          <span class="cat">language</span>
        </span>
      </a>

      <a class="star tribe-sw mag-3 sz-sm" style="top: 36%; left: 92%;" href="#" aria-label="SQL Server">
        <span class="glyph">Ss</span>
        <span class="catalog">
          <span class="row1"><span class="name">SQL Server</span><span class="mag">m 2.6</span></span>
          <span class="cat-coord">17h 25m · +12°</span>
          <span class="cat">database</span>
        </span>
      </a>

      <a class="star tribe-sw mag-2 sz-md" style="top: 32%; left: 4%;" href="#" aria-label="TypeScript">
        <span class="glyph">Ts<span class="twinkle"></span></span>
        <span class="catalog">
          <span class="row1"><span class="name">TypeScript</span><span class="mag">m 1.8</span></span>
          <span class="cat-coord">15h 11m · +33°</span>
          <span class="cat">language</span>
        </span>
      </a>

      <a class="star tribe-sw mag-3 sz-sm" style="top: 6%; left: 70%;" href="#" aria-label="Python">
        <span class="glyph">Py</span>
        <span class="catalog">
          <span class="row1"><span class="name">Python</span><span class="mag">m 2.6</span></span>
          <span class="cat-coord">17h 41m · +28°</span>
          <span class="cat">language</span>
        </span>
      </a>

      <a class="star tribe-sw mag-4 sz-xs hide-sm" style="top: 60%; left: 5%;" href="#" aria-label="Blazor">
        <span class="glyph">Bz</span>
        <span class="catalog">
          <span class="row1"><span class="name">Blazor</span><span class="mag">m 4.0</span></span>
          <span class="cat-coord">15h 47m · +08°</span>
          <span class="cat">web-ui</span>
        </span>
      </a>

      <a class="star tribe-sw mag-4 sz-xs hide-sm" style="top: 28%; left: 22%;" href="#" aria-label="HTML">
        <span class="glyph">Ht</span>
        <span class="catalog">
          <span class="row1"><span class="name">HTML</span><span class="mag">m 4.2</span></span>
          <span class="cat-coord">15h 12m · +18°</span>
          <span class="cat">web-markup</span>
        </span>
      </a>

      <a class="star tribe-sw mag-4 sz-xs hide-sm" style="top: 70%; left: 85%;" href="#" aria-label="CSS">
        <span class="glyph">Cs</span>
        <span class="catalog">
          <span class="row1"><span class="name">CSS</span><span class="mag">m 4.3</span></span>
          <span class="cat-coord">17h 48m · −04°</span>
          <span class="cat">web-style</span>
        </span>
      </a>

      <a class="star tribe-sw mag-2 sz-md" style="top: 56%; left: 90%;" href="#" aria-label="PostgreSQL">
        <span class="glyph">Pg<span class="twinkle"></span></span>
        <span class="catalog">
          <span class="row1"><span class="name">PostgreSQL</span><span class="mag">m 1.6</span></span>
          <span class="cat-coord">17h 58m · +03°</span>
          <span class="cat">database</span>
        </span>
      </a>

      <a class="star tribe-sw mag-3 sz-sm" style="top: 88%; left: 8%;" href="#" aria-label="AWS">
        <span class="glyph">Aws</span>
        <span class="catalog">
          <span class="row1"><span class="name">Amazon Web Services</span><span class="mag">m 2.7</span></span>
          <span class="cat-coord">15h 24m · −12°</span>
          <span class="cat">cloud</span>
        </span>
      </a>

      <a class="star tribe-sw mag-3 sz-sm" style="top: 42%; left: 26%;" href="#" aria-label="Docker">
        <span class="glyph">Dk</span>
        <span class="catalog">
          <span class="row1"><span class="name">Docker</span><span class="mag">m 2.8</span></span>
          <span class="cat-coord">18h 31m · −16°</span>
          <span class="cat">containers</span>
        </span>
      </a>

      <a class="star tribe-hw mag-4 sz-xs hide-sm" style="top: 4%; left: 50%;" href="#" aria-label="WPF">
        <span class="glyph">Wpf</span>
        <span class="catalog">
          <span class="row1"><span class="name">Windows Presentation Foundation</span><span class="mag">m 4.0</span></span>
          <span class="cat-coord">14h 58m · +44°</span>
          <span class="cat">desktop-ui</span>
        </span>
      </a>

      <a class="star tribe-hw mag-2 sz-md" style="top: 18%; left: 86%;" href="#" aria-label="Modbus">
        <span class="glyph">Mb<span class="twinkle"></span></span>
        <span class="catalog">
          <span class="row1"><span class="name">Modbus</span><span class="mag">m 1.9</span></span>
          <span class="cat-coord">17h 12m · +38°</span>
          <span class="cat">protocol</span>
        </span>
      </a>

      <a class="star tribe-hw mag-4 sz-xs hide-sm" style="top: 92%; left: 50%;" href="#" aria-label="IEC 60870-5">
        <span class="glyph">IEC</span>
        <span class="catalog">
          <span class="row1"><span class="name">IEC 60870-5</span><span class="mag">m 4.1</span></span>
          <span class="cat-coord">15h 02m · −22°</span>
          <span class="cat">protocol</span>
        </span>
      </a>

      <a class="star tribe-hw mag-3 sz-sm" style="top: 86%; left: 72%;" href="#" aria-label="PLC">
        <span class="glyph">PLC</span>
        <span class="catalog">
          <span class="row1"><span class="name">Programmable Logic Controller</span><span class="mag">m 2.5</span></span>
          <span class="cat-coord">17h 38m · −26°</span>
          <span class="cat">hardware</span>
        </span>
      </a>
    </div>

    <div class="planets">
      {planets.map((p) => (
        <article
          class:list={["planet-slot", `slot-${p.kind}`, `side-${p.side}`]}
          style={`top: ${p.top}; left: ${p.left};`}
        >
          <div class={`xstar ${p.kind}`}>
            <div class="body">
              {p.kind === "treew" && (
                <>
                  <div class="neb-haze"></div>
                  <div class="neb-cloud"></div>
                  <div class="neb-core"></div>
                  <div class="neb-ring r1">
                    <span class="neb-pip p1"></span>
                    <span class="neb-pip p2"></span>
                  </div>
                  <div class="neb-ring r2"></div>
                </>
              )}

              {p.kind === "gsi" && (
                <>
                  <div class="giant-rings">
                    <div class="giant-ring outer"></div>
                    <div class="giant-ring mid"></div>
                    <div class="giant-ring inner"></div>
                  </div>
                  <div class="giant-atm"></div>
                  <div class="giant-body"></div>
                </>
              )}

              {p.kind === "ati" && (
                <>
                  <div class="pulsar-haze"></div>
                  <div class="pulsar-beam"></div>
                  <div class="pulsar-beam b2"></div>
                  <div class="pulsar-ring r1"></div>
                  <div class="pulsar-ring r2"></div>
                  <div class="pulsar-ring r3"></div>
                  <div class="pulsar-core"></div>
                </>
              )}
            </div>

            <div class="hud">
              <span class="hud-line"></span>
              <div class="hud-stack">
                <h3 class="hud-company">{p.company}</h3>
                <span class="hud-divider"></span>
                <p class="hud-date">{p.dateStart}</p>
                <p class="hud-desc">
                  <span class="hud-role">{p.role}</span>
                  {p.description}
                </p>
              </div>
            </div>

            <div class:list={["hud-callout", `hover-${p.hoverSide}`]} aria-hidden="true">
              <svg class="hc-leader" viewBox="0 0 380 150" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                {p.hoverSide === "left" ? (
                  <>
                    {/* Diagonal up-LEFT at 30° (len 110) from planet center (380,150) to bend (285,95);
                        horizontal (len 275) ends at far-left (10,95). */}
                    <path class="hc-leader-stroke" d="M 380 150 L 285 95 L 10 95" />
                    <circle class="hc-dot hc-dot-bend" cx="285" cy="95" r="2.5" />
                    <circle class="hc-dot hc-dot-end" cx="10" cy="95" r="2.5" />
                  </>
                ) : (
                  <>
                    {/* Diagonal up-RIGHT at 30° (len 110) from planet center (0,150) to bend (95,95);
                        horizontal (len 275) ends at far-right (370,95). */}
                    <path class="hc-leader-stroke" d="M 0 150 L 95 95 L 370 95" />
                    <circle class="hc-dot hc-dot-bend" cx="95" cy="95" r="2.5" />
                    <circle class="hc-dot hc-dot-end" cx="370" cy="95" r="2.5" />
                  </>
                )}
              </svg>

              <div class="hc-row hc-row-top">
                <span class="hc-company-out">{p.company}</span>
                <span class="hc-date-out">{p.dateStart} &ndash; {p.dateEnd}</span>
              </div>
              <div class="hc-row hc-row-bottom">
                <p class="hc-role-out">{p.role}</p>
                <p class="hc-desc-out">{p.description}</p>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .work {
    position: relative;
    z-index: 2;
    min-height: calc(100vh - 76px);
    display: grid;
    place-items: center;
    padding: 80px 24px 80px;
  }
  .work-stage {
    position: relative;
    width: 100%;
    max-width: 1240px;
    aspect-ratio: 16 / 10;
    max-height: 88vh;
  }

  .constellation {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }
  .constellation > * { pointer-events: auto; }

  /* ============================================================
     EXPERIENCE PLANETS — three celestial bodies, one per role
     ============================================================ */
  .planets {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
  }
  .planets > * { pointer-events: auto; }

  .planet-slot {
    position: absolute;
    transform: translate(-50%, -50%);
  }

  .xstar {
    position: relative;
    width: 140px;
    height: 140px;
    isolation: isolate;
  }

  .xstar .body {
    position: absolute;
    inset: 0;
  }

  /* ----------- TREEW · emission nebula (muted) ----------- */
  .xstar.treew .neb-core {
    position: absolute;
    inset: 32%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 50%,
        var(--color-star-warm) 0%,
        var(--color-star-amber) 30%,
        color-mix(in oklch, var(--color-star-amber) 0%, transparent) 65%);
    filter: blur(2px);
    z-index: 3;
    animation: neb-pulse 7s ease-in-out infinite;
  }
  .xstar.treew .neb-cloud {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      radial-gradient(circle at 38% 42%,
        color-mix(in oklch, var(--color-star-amber) 32%, transparent) 0%,
        transparent 38%),
      radial-gradient(circle at 64% 58%,
        color-mix(in oklch, var(--color-accent-secondary) 18%, transparent) 0%,
        transparent 42%),
      radial-gradient(circle at 50% 50%,
        color-mix(in oklch, var(--color-star-warm) 10%, transparent) 0%,
        transparent 55%);
    filter: blur(8px);
    z-index: 2;
    transition: filter 320ms ease;
  }
  .xstar.treew .neb-haze {
    position: absolute;
    inset: -16%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 50%,
      color-mix(in oklch, var(--color-accent-secondary) 9%, transparent),
      transparent 55%);
    filter: blur(20px);
    z-index: 1;
    opacity: 0.7;
    transition: opacity 320ms ease, transform 320ms ease;
  }
  .xstar.treew .neb-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px dashed;
    z-index: 4;
    opacity: 0.32;
    transition: opacity 280ms ease;
  }
  .xstar.treew .neb-ring.r1 {
    inset: -6%;
    border-color: color-mix(in oklch, var(--color-star-amber) 70%, transparent);
    animation: spin-cw 60s linear infinite;
  }
  .xstar.treew .neb-ring.r2 {
    inset: -16%;
    border-color: color-mix(in oklch, var(--color-accent-secondary) 50%, transparent);
    border-style: dotted;
    opacity: 0.22;
    animation: spin-ccw 90s linear infinite;
  }
  .xstar.treew .neb-pip {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-star-warm);
    box-shadow: 0 0 5px var(--color-star-warm);
    z-index: 5;
  }
  .xstar.treew .neb-pip.p1 { top: -2px; left: 50%; transform: translateX(-50%); }
  .xstar.treew .neb-pip.p2 {
    bottom: -2px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-accent-secondary);
    box-shadow: 0 0 5px var(--color-accent-secondary);
  }

  .xstar.treew:hover .neb-haze,
  .xstar.treew:focus-within .neb-haze {
    opacity: 1;
    transform: scale(1.08);
  }
  .xstar.treew:hover .neb-cloud,
  .xstar.treew:focus-within .neb-cloud {
    filter: blur(6px) brightness(1.08);
  }
  .xstar.treew:hover .neb-ring,
  .xstar.treew:focus-within .neb-ring { opacity: 0.55; }

  /* ----------- GSI · ringed gas giant (muted, Saturn-style) ----------- */
  .xstar.gsi .giant-body {
    position: absolute;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background:
      radial-gradient(circle at 32% 32%,
        color-mix(in oklch, var(--color-star-warm) 70%, transparent) 0%,
        color-mix(in oklch, var(--color-star-amber) 55%, transparent) 18%,
        transparent 42%),
      linear-gradient(180deg,
        color-mix(in oklch, var(--color-text-muted) 70%, var(--color-background)) 0%,
        color-mix(in oklch, var(--color-star-amber) 35%, var(--color-background)) 40%,
        color-mix(in oklch, var(--color-star-amber) 25%, var(--color-background)) 60%,
        color-mix(in oklch, var(--color-text-muted) 60%, var(--color-background)) 100%);
    box-shadow:
      inset -8px -10px 24px color-mix(in oklch, var(--color-background) 70%, transparent),
      inset 4px 6px 12px color-mix(in oklch, var(--color-star-warm) 6%, transparent),
      0 0 36px color-mix(in oklch, var(--color-star-amber) 8%, transparent);
    z-index: 3;
    transition: box-shadow 320ms ease;
  }
  .xstar.gsi .giant-atm {
    position: absolute;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle at 50% 50%,
      transparent 60%,
      color-mix(in oklch, var(--color-star-amber) 12%, transparent) 70%,
      transparent 78%);
    z-index: 2;
    transition: transform 320ms ease, opacity 320ms ease;
  }
  .xstar.gsi .giant-rings {
    position: absolute;
    width: 180px;
    height: 46px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-18deg);
    z-index: 1;
    transition: transform 480ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .xstar.gsi .giant-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }
  .xstar.gsi .giant-ring.outer {
    border: 1px solid color-mix(in oklch, var(--color-text-muted) 60%, transparent);
    background: radial-gradient(ellipse at center,
      transparent 60%,
      color-mix(in oklch, var(--color-text-muted) 22%, transparent) 70%,
      color-mix(in oklch, var(--color-text-muted) 30%, transparent) 80%,
      transparent 92%);
  }
  .xstar.gsi .giant-ring.mid {
    inset: 5px 12px;
    border: 1px solid color-mix(in oklch, var(--color-border) 90%, transparent);
    background: radial-gradient(ellipse at center,
      transparent 55%,
      color-mix(in oklch, var(--color-text-muted) 14%, transparent) 75%,
      transparent 90%);
  }
  .xstar.gsi .giant-ring.inner {
    inset: 11px 24px;
    border: 1px dashed color-mix(in oklch, var(--color-border) 80%, transparent);
  }
  .xstar.gsi .giant-rings::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 180px;
    height: 22px;
    border-radius: 50%;
    box-shadow: inset 0 1px 0 color-mix(in oklch, var(--color-text-muted) 45%, transparent);
    pointer-events: none;
  }

  .xstar.gsi:hover .giant-body,
  .xstar.gsi:focus-within .giant-body {
    box-shadow:
      inset -8px -10px 24px color-mix(in oklch, var(--color-background) 70%, transparent),
      inset 4px 6px 12px color-mix(in oklch, var(--color-star-warm) 9%, transparent),
      0 0 60px color-mix(in oklch, var(--color-star-amber) 18%, transparent);
  }
  .xstar.gsi:hover .giant-atm,
  .xstar.gsi:focus-within .giant-atm {
    transform: translate(-50%, -50%) scale(1.05);
  }
  .xstar.gsi:hover .giant-rings,
  .xstar.gsi:focus-within .giant-rings {
    transform: translate(-50%, -50%) rotate(-22deg);
  }

  /* ----------- ATI · pulsar (vivid yellow-orange core, hover-activated rings) ----------- */
  .xstar.ati .body {
    overflow: visible;
  }
  .xstar.ati .pulsar-core {
    position: absolute;
    width: 62px;
    height: 62px;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    /*
     * Deep ember stops (#8B3A0F, #3D1A05) are inline hex on purpose:
     * they are aesthetic primitives outside the system palette and an
     * oklch mix between accent-primary and background produces a
     * perceptually different shade. Keep the literals so this matches
     * the Claude Design source exactly.
     */
    background:
      radial-gradient(circle at 50% 50%,
        var(--color-star-warm) 0%,
        var(--color-star-amber) 18%,
        var(--color-accent-primary) 42%,
        #8B3A0F 70%,
        #3D1A05 100%);
    box-shadow:
      0 0 24px color-mix(in oklch, var(--color-star-amber) 70%, transparent),
      0 0 48px color-mix(in oklch, var(--color-accent-primary) 45%, transparent),
      0 0 96px color-mix(in oklch, var(--color-accent-primary) 18%, transparent),
      inset -4px -4px 12px color-mix(in oklch, var(--color-background) 40%, transparent),
      inset 3px 3px 8px color-mix(in oklch, var(--color-star-warm) 50%, transparent);
    z-index: 5;
    transition: box-shadow 320ms ease, transform 320ms ease;
  }
  .xstar.ati .pulsar-haze {
    position: absolute;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle at center,
      color-mix(in oklch, var(--color-accent-primary) 22%, transparent) 0%,
      color-mix(in oklch, var(--color-accent-primary) 10%, transparent) 25%,
      transparent 55%);
    filter: blur(6px);
    z-index: 1;
    opacity: 0.5;
    transition: opacity 320ms ease, transform 320ms ease;
  }
  .xstar.ati .pulsar-ring {
    position: absolute;
    border: 1px solid var(--color-accent-primary);
    border-radius: 50%;
    top: 50%;
    left: 50%;
    z-index: 2;
    opacity: 0;
    transition: opacity 320ms ease;
  }
  .xstar.ati .pulsar-ring.r1 {
    width: 80px;
    height: 80px;
    transform: translate(-50%, -50%);
    border-color: color-mix(in oklch, var(--color-accent-primary) 55%, transparent);
    animation: pulse-1 4.2s ease-out infinite;
    animation-play-state: running;
  }
  .xstar.ati .pulsar-ring.r2 {
    width: 90px;
    height: 90px;
    transform: translate(-50%, -50%);
    border-color: color-mix(in oklch, var(--color-star-amber) 40%, transparent);
    border-style: dashed;
    animation: pulse-2 5.4s ease-out infinite;
    animation-play-state: running;
  }
  .xstar.ati .pulsar-ring.r3 {
    width: 100px;
    height: 100px;
    transform: translate(-50%, -50%);
    border-color: color-mix(in oklch, var(--color-accent-primary) 25%, transparent);
    animation: pulse-3 6.6s ease-out infinite;
    animation-play-state: running;
  }
  .xstar.ati .pulsar-beam {
    position: absolute;
    width: 200px;
    height: 1px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: linear-gradient(90deg,
      transparent 0%,
      color-mix(in oklch, var(--color-star-warm) 40%, transparent) 45%,
      color-mix(in oklch, var(--color-star-warm) 70%, transparent) 50%,
      color-mix(in oklch, var(--color-star-warm) 40%, transparent) 55%,
      transparent 100%);
    z-index: 4;
    opacity: 0;
    filter: blur(0.5px);
    animation: spin-beam 18s linear infinite;
    transition: opacity 320ms ease;
  }
  .xstar.ati .pulsar-beam.b2 {
    animation-duration: 22s;
    animation-direction: reverse;
    transform: translate(-50%, -50%) rotate(60deg);
  }

  .xstar.ati:hover .pulsar-core,
  .xstar.ati:focus-within .pulsar-core,
  .xstar.ati.is-hover .pulsar-core {
    transform: translate(-50%, -50%) scale(1.08);
    box-shadow:
      0 0 36px color-mix(in oklch, var(--color-star-amber) 85%, transparent),
      0 0 80px color-mix(in oklch, var(--color-accent-primary) 60%, transparent),
      0 0 140px color-mix(in oklch, var(--color-accent-primary) 30%, transparent),
      inset -4px -4px 12px color-mix(in oklch, var(--color-background) 40%, transparent),
      inset 3px 3px 8px color-mix(in oklch, var(--color-star-warm) 60%, transparent);
  }
  .xstar.ati:hover .pulsar-haze,
  .xstar.ati:focus-within .pulsar-haze,
  .xstar.ati.is-hover .pulsar-haze {
    transform: translate(-50%, -50%) scale(1.1);
    opacity: 1;
  }
  .xstar.ati:hover .pulsar-ring,
  .xstar.ati:focus-within .pulsar-ring,
  .xstar.ati.is-hover .pulsar-ring {
    opacity: 1;
  }
  .xstar.ati:hover .pulsar-beam,
  .xstar.ati:focus-within .pulsar-beam,
  .xstar.ati.is-hover .pulsar-beam {
    opacity: 0.55;
  }
  .xstar.ati:hover .pulsar-beam.b2,
  .xstar.ati:focus-within .pulsar-beam.b2,
  .xstar.ati.is-hover .pulsar-beam.b2 {
    opacity: 0.3;
  }

  /* ============================================================
     STAR-WARS HUD LABEL — connector line + side-mounted readout
     ============================================================ */
  .hud {
    position: absolute;
    top: 50%;
    display: flex;
    align-items: center;
    pointer-events: none;
  }
  /* `right` side: connector goes right from the planet edge */
  .side-right .hud {
    left: 100%;
    flex-direction: row;
    transform: translateY(-50%);
  }
  .side-left .hud {
    right: 100%;
    flex-direction: row-reverse;
    transform: translateY(-50%);
  }
  .hud-line {
    display: block;
    width: 50px;
    height: 1px;
    background: var(--color-text-muted);
    opacity: 0.4;
    flex-shrink: 0;
  }
  .hud-stack {
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    min-width: 140px;
    max-width: 180px;
    padding: 0 4px;
  }
  .side-left .hud-stack { align-items: flex-end; text-align: right; }
  .side-right .hud-stack { align-items: flex-start; text-align: left; }

  .hud-company {
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin: 0 0 6px;
    line-height: 1.2;
  }
  .hud-divider {
    display: block;
    width: 100%;
    height: 1px;
    background: color-mix(in oklch, var(--color-border) 70%, transparent);
    margin-bottom: 6px;
  }
  .hud-date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
  }
  .hud-desc {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin: 0;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height 380ms cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 280ms 80ms ease,
      margin-top 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
    text-wrap: pretty;
  }
  .hud-role {
    display: block;
    font-weight: 500;
    color: var(--color-text-primary);
    font-size: 12px;
    margin-bottom: 4px;
  }
  /*
   * The default .hud no longer reveals its inner description on hover —
   * the HUD-callout handles that. Without this no-op rule, the previous
   * 0→220px expansion of .hud-desc would grow the centered/bottom-anchored
   * .hud container during the fade-out, producing an unintended upward
   * drift on GSI and Treew before the opacity reached zero.
   */
  .xstar:hover .hud-desc,
  .xstar:focus-within .hud-desc {
    max-height: 0;
    opacity: 0;
    margin-top: 0;
  }

  /*
   * ATI variant of the HUD: bottom-mounted, single-line "company · date",
   * no connector line, no divider rule. Description still reveals on hover
   * below the line. Other planets (treew, gsi) keep the side-mounted HUD.
   */
  .slot-ati .hud {
    top: calc(100% + 12px);
    left: 50%;
    right: auto;
    bottom: auto;
    transform: translateX(-50%);
    flex-direction: column;
    align-items: center;
  }
  .slot-ati .hud-line { display: none; }
  .slot-ati .hud-divider { display: none; }
  .slot-ati .hud-stack {
    display: block;
    text-align: center;
    min-width: 0;
    max-width: 240px;
    padding: 0;
    align-items: center;
  }
  .slot-ati .hud-company {
    margin: 0 0 2px;
  }
  .slot-ati .hud-date {
    margin: 0;
  }
  .slot-ati .hud-desc {
    display: block;
    margin-top: 0;
    text-align: center;
  }

  /*
   * GSI default: same minimal style as ATI (no connector, no divider,
   * vertical stack, centered text), but anchored to the RIGHT of the planet.
   */
  .slot-gsi .hud {
    top: 50%;
    left: calc(100% + 12px);
    right: auto;
    bottom: auto;
    transform: translateY(-50%);
    flex-direction: column;
    align-items: center;
  }
  .slot-gsi .hud-line { display: none; }
  .slot-gsi .hud-divider { display: none; }
  .slot-gsi .hud-stack {
    display: block;
    text-align: center;
    min-width: 0;
    max-width: 240px;
    padding: 0;
    align-items: center;
  }
  .slot-gsi .hud-company { margin: 0 0 2px; }
  .slot-gsi .hud-date { margin: 0; }
  .slot-gsi .hud-desc {
    display: block;
    margin-top: 0;
    text-align: center;
  }

  /*
   * Treew default: same minimal style as ATI, anchored ABOVE the planet
   * and offset to the LEFT of the planet center.
   */
  .slot-treew .hud {
    top: auto;
    left: 50%;
    right: auto;
    bottom: calc(100% + 12px);
    transform: translateX(calc(-50% - 72px));
    flex-direction: column;
    align-items: center;
  }
  .slot-treew .hud-line { display: none; }
  .slot-treew .hud-divider { display: none; }
  .slot-treew .hud-stack {
    display: block;
    text-align: center;
    min-width: 0;
    max-width: 240px;
    padding: 0;
    align-items: center;
  }
  .slot-treew .hud-company { margin: 0 0 2px; }
  .slot-treew .hud-date { margin: 0; }
  .slot-treew .hud-desc {
    display: block;
    margin-top: 0;
    text-align: center;
  }

  /* ============================================================
     HUD-CALLOUT — diagonal leader + horizontal readout (hover)
     The container is 380×150; one of its bottom corners is anchored
     at the planet center via `hover-left` / `hover-right`, so the
     callout extends into the corresponding upper quadrant.
     ============================================================ */
  .hud-callout {
    position: absolute;
    bottom: 50%;
    width: 380px;
    height: 150px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms ease;
    z-index: 6;
  }
  /* hover-left: bottom-right corner anchored at planet center (callout extends up-LEFT). */
  .hud-callout.hover-left {
    right: 50%;
    left: auto;
  }
  /* hover-right: bottom-left corner anchored at planet center (callout extends up-RIGHT). */
  .hud-callout.hover-right {
    left: 50%;
    right: auto;
  }

  .xstar:hover .hud-callout,
  .xstar:focus-within .hud-callout {
    opacity: 1;
    pointer-events: auto;
    transition: opacity 220ms 80ms ease;
  }

  /* Hide the default HUD on every planet while the callout takes over.
     For GSI and Treew, the slot-specific rules below also nudge the label
     toward the planet center so the fade reads as a "pull-in" rather than
     a flat opacity drop. */
  .xstar:hover .hud,
  .xstar:focus-within .hud {
    opacity: 0;
    transition: opacity 180ms ease, transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
    pointer-events: none;
  }
  /* On return-to-default, wait for the callout to fade out before the default
     HUD reappears, so the two never visually overlap. */
  .hud {
    transition:
      opacity 220ms 120ms ease,
      transform 280ms 120ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* GSI fade-out: pull toward the planet (which sits to the LEFT). */
  .slot-gsi .xstar:hover .hud,
  .slot-gsi .xstar:focus-within .hud {
    transform: translateY(-50%) translateX(-14px);
  }

  /* Treew fade-out: pull toward the planet (which sits BELOW-RIGHT,
     since the default label is anchored above and 32px to the left). */
  .slot-treew .xstar:hover .hud,
  .slot-treew .xstar:focus-within .hud {
    transform: translateX(calc(-50% - 22px)) translateY(10px);
  }

  .hc-leader {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .hc-leader-stroke {
    fill: none;
    stroke: var(--color-accent-secondary);
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* Path length: 110 (diagonal) + 275 (horizontal) = 385 */
    stroke-dasharray: 390;
    stroke-dashoffset: 390;
    transition: stroke-dashoffset 720ms cubic-bezier(0.4, 0, 0.2, 1) 80ms;
    filter: drop-shadow(0 0 3px color-mix(in oklch, var(--color-accent-secondary) 35%, transparent));
  }
  .xstar:hover .hc-leader-stroke,
  .xstar:focus-within .hc-leader-stroke {
    stroke-dashoffset: 0;
  }

  .hc-dot {
    fill: var(--color-accent-secondary);
    opacity: 0;
    transition: opacity 180ms ease;
    filter: drop-shadow(0 0 3px color-mix(in oklch, var(--color-accent-secondary) 60%, transparent));
  }
  /* Bend dot lands when the diagonal finishes drawing (~430ms in). */
  .hc-dot-bend {
    transition: opacity 180ms 470ms ease;
  }
  /* End dot lands when the horizontal finishes drawing (~800ms in). */
  .hc-dot-end {
    transition: opacity 180ms 800ms ease;
  }
  .xstar:hover .hc-dot,
  .xstar:focus-within .hc-dot {
    opacity: 1;
  }

  /* Top row: above the horizontal line at y=95.
     Span depends on side (DOM order is always [company, date], so flex
     space-between always lands company on visual left, date on visual right). */
  .hc-row-top {
    position: absolute;
    top: 0;
    height: 91px;
    width: 275px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 4px;
    pointer-events: none;
  }
  /* hover-left: horizontal spans x=10 (far end) → x=285 (bend). */
  .hover-left .hc-row-top { left: 10px; }
  /* hover-right: horizontal spans x=95 (bend) → x=370 (far end). */
  .hover-right .hc-row-top { left: 95px; }
  .hc-company-out {
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    line-height: 1.2;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 280ms 380ms ease, transform 320ms 380ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .hc-date-out {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    line-height: 1.2;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(6px);
    transition: opacity 280ms 520ms ease, transform 320ms 520ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* Bottom row: below the horizontal line. Role + description align toward
     the FAR-END of the horizontal (i.e. the extreme away from the planet). */
  .hc-row-bottom {
    position: absolute;
    top: 101px;
    width: 275px; /* matches horizontal span */
    pointer-events: none;
  }
  .hover-left .hc-row-bottom {
    left: 10px;
    text-align: left; /* far end is on the left */
  }
  .hover-right .hc-row-bottom {
    left: 95px;
    text-align: right; /* far end is on the right */
  }
  .hc-role-out {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    color: var(--color-text-primary);
    margin: 0 0 4px;
    line-height: 1.3;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 280ms 700ms ease, transform 320ms 700ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .hc-desc-out {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0;
    text-wrap: pretty;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 320ms 800ms ease, transform 360ms 800ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .xstar:hover .hc-company-out,
  .xstar:focus-within .hc-company-out,
  .xstar:hover .hc-date-out,
  .xstar:focus-within .hc-date-out,
  .xstar:hover .hc-role-out,
  .xstar:focus-within .hc-role-out,
  .xstar:hover .hc-desc-out,
  .xstar:focus-within .hc-desc-out {
    opacity: 1;
    transform: translate(0, 0);
  }

  /* ============================================================
     SKILL STARS — same visual language as before
     ============================================================ */
  .star {
    position: absolute;
    transform: translate(-50%, -50%);
    cursor: pointer;
    --halo: color-mix(in oklch, var(--color-star-warm) 50%, transparent);
    --tone: var(--color-star-warm);
    text-decoration: none;
  }

  .star.mag-1 { animation: drift1 11s ease-in-out infinite; }
  .star.mag-2 { animation: drift2 13s ease-in-out infinite; }
  .star.mag-3 { animation: drift3 9s  ease-in-out infinite; }
  .star.mag-4 { animation: drift4 14s ease-in-out infinite; }

  @keyframes drift1 {
    0%, 100% { transform: translate(-50%, -50%) translateY(0); }
    50%      { transform: translate(-50%, -50%) translateY(-6px); }
  }
  @keyframes drift2 {
    0%, 100% { transform: translate(-50%, -50%) translateY(0); }
    50%      { transform: translate(-50%, -50%) translateY(5px); }
  }
  @keyframes drift3 {
    0%, 100% { transform: translate(-50%, -50%) translateY(0); }
    50%      { transform: translate(-50%, -50%) translateY(-4px); }
  }
  @keyframes drift4 {
    0%, 100% { transform: translate(-50%, -50%) translateY(0); }
    50%      { transform: translate(-50%, -50%) translateY(3px); }
  }

  .star .glyph {
    position: relative;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
    transition:
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 0.3s,
      box-shadow 0.4s,
      background 0.3s;
  }

  .star.sz-xl .glyph { width: 56px; height: 56px; font-size: 16px; border-radius: 12px; }
  .star.sz-lg .glyph { width: 48px; height: 48px; font-size: 14px; border-radius: 10px; }
  .star.sz-md .glyph { width: 40px; height: 40px; font-size: 12px; }
  .star.sz-sm .glyph { width: 32px; height: 32px; font-size: 11px; border-radius: 6px; }
  .star.sz-xs .glyph { width: 26px; height: 26px; font-size: 10px; border-radius: 5px; }

  .star.mag-1 .glyph {
    opacity: 1.0;
    box-shadow:
      0 0 0 1px color-mix(in oklch, var(--color-text-primary) 2%, transparent),
      0 4px 24px -8px color-mix(in oklch, var(--color-background) 60%, transparent);
  }
  .star.mag-2 .glyph { opacity: 0.92; }
  .star.mag-3 .glyph { opacity: 0.78; }
  .star.mag-4 .glyph { opacity: 0.55; }

  .star.tribe-hw .glyph {
    color: var(--color-accent-primary);
    --halo: color-mix(in oklch, var(--color-accent-primary) 55%, transparent);
  }
  .star.tribe-sw .glyph {
    color: var(--color-accent-secondary);
    --halo: color-mix(in oklch, var(--color-accent-secondary) 50%, transparent);
  }

  .star .glyph::before {
    content: "";
    position: absolute;
    inset: -14px;
    border-radius: inherit;
    background: radial-gradient(circle at center, var(--halo), transparent 65%);
    opacity: 0;
    transition: opacity 0.4s;
    z-index: -1;
    filter: blur(6px);
  }

  .star:hover .glyph,
  .star:focus-visible .glyph {
    transform: scale(1.08);
    border-color: currentColor;
    background: var(--color-surface-2);
    opacity: 1;
  }
  .star:hover .glyph::before,
  .star:focus-visible .glyph::before {
    opacity: 1;
  }

  .catalog {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 10px 14px;
    min-width: 168px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s, transform 0.25s;
    z-index: 10;
    backdrop-filter: blur(8px);
    box-shadow: 0 8px 28px -8px color-mix(in oklch, var(--color-background) 70%, transparent);
    display: block;
  }
  .catalog::before {
    content: "";
    position: absolute;
    top: -5px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 8px;
    height: 8px;
    background: var(--color-surface);
    border-left: 1px solid var(--color-border);
    border-top: 1px solid var(--color-border);
  }
  .star:hover .catalog,
  .star:focus-visible .catalog {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }
  .catalog .row1 {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
  }
  .catalog .name {
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 13px;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }
  .catalog .mag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    color: var(--color-text-muted);
    letter-spacing: 0.1em;
  }
  .catalog .cat-coord {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--color-text-secondary);
    letter-spacing: 0.04em;
    margin-bottom: 6px;
  }
  .catalog .cat {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 3px;
    border: 1px solid;
  }
  .star.tribe-hw .catalog .cat {
    color: var(--color-accent-primary);
    border-color: color-mix(in oklch, var(--color-accent-primary) 30%, transparent);
  }
  .star.tribe-sw .catalog .cat {
    color: var(--color-accent-secondary);
    border-color: color-mix(in oklch, var(--color-accent-secondary) 30%, transparent);
  }

  .star .twinkle {
    position: absolute;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: var(--color-star-warm);
    top: 4px;
    right: 4px;
    box-shadow: 0 0 4px var(--color-star-warm);
    opacity: 0.6;
    animation: twinkle 4s ease-in-out infinite;
  }
  .star.tribe-sw .twinkle {
    background: var(--color-star-cool);
    box-shadow: 0 0 4px var(--color-star-cool);
  }
  .star.tribe-hw .twinkle {
    background: var(--color-star-amber);
    box-shadow: 0 0 4px var(--color-star-amber);
  }
  @keyframes twinkle {
    0%, 100% { opacity: 0.25; transform: scale(0.85); }
    50%      { opacity: 0.85; transform: scale(1.1); }
  }
  .star.mag-3 .twinkle, .star.mag-4 .twinkle { display: none; }

  /* ============================================================
     SHARED KEYFRAMES
     ============================================================ */
  @keyframes spin-cw  { to { transform: rotate(360deg); } }
  @keyframes spin-ccw { to { transform: rotate(-360deg); } }
  @keyframes neb-pulse {
    0%, 100% { filter: blur(2px) brightness(1); }
    50%      { filter: blur(2px) brightness(1.12); }
  }
  @keyframes spin-beam {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to   { transform: translate(-50%, -50%) rotate(360deg); }
  }
  @keyframes pulse-1 {
    0%   { width: 80px;  height: 80px;  opacity: 0.75; }
    100% { width: 200px; height: 200px; opacity: 0;    }
  }
  @keyframes pulse-2 {
    0%   { width: 90px;  height: 90px;  opacity: 0.6;  }
    100% { width: 220px; height: 220px; opacity: 0;    }
  }
  @keyframes pulse-3 {
    0%   { width: 100px; height: 100px; opacity: 0.4;  }
    100% { width: 250px; height: 250px; opacity: 0;    }
  }

  /* ============================================================
